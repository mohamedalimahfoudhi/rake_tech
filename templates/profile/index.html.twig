{% extends 'base.html.twig' %}

{% block title %}Profile{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <a href="{{ path('app_dashboard') }}" class="btn btn-success">
                        <i class="fas fa-arrow-left"></i> Back to Dashboard
                    </a>
                    <h1 class="h3 mb-0 font-weight-normal text-center">Profile</h1>
                    <div style="width: 100px;"></div> <!-- Spacer for balance -->
                </div>
                <div class="card-body">
                    {% for message in app.flashes('success') %}
                        <div class="alert alert-success">
                            {{ message }}
                        </div>
                    {% endfor %}

                    <div class="row mb-4">
                        <div class="col-md-4 text-center">
                            {% if user.photoProfil %}
                                <img src="{{ asset('uploads/profile_pictures/' ~ user.photoProfil) }}" 
                                     alt="Profile Picture" 
                                     class="img-thumbnail mb-3"
                                     style="max-width: 200px;">
                            {% else %}
                                <img src="{{ asset('images/default-profile.png') }}" 
                                     alt="Default Profile Picture" 
                                     class="img-thumbnail mb-3"
                                     style="max-width: 200px;">
                            {% endif %}
                        </div>
                        <div class="col-md-8">
                            <h4>{{ user.prenom }} {{ user.nom }}</h4>
                            <p class="text-muted">{{ user.email }}</p>
                            {% if user.role %}
                                <p><strong>Role:</strong> {{ user.role.roleNom }}</p>
                            {% endif %}
                        </div>
                    </div>

                    {{ form_start(profileForm) }}
                        <div class="row">
                            <div class="col-md-6">
                                {{ form_row(profileForm.email) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(profileForm.plainPassword) }}
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                {{ form_row(profileForm.prenom) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(profileForm.nom) }}
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                {{ form_row(profileForm.genre) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(profileForm.numeroTelephone) }}
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12">
                                {{ form_row(profileForm.adresse) }}
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12">
                                {{ form_row(profileForm.nomOrganisation) }}
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12">
                                {{ form_row(profileForm.photoProfil) }}
                            </div>
                        </div>

                        <div class="d-grid gap-2 mt-3">
                            <button type="submit" class="btn btn-lg btn-primary">Update Profile</button>
                        </div>
                    {{ form_end(profileForm) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %} 