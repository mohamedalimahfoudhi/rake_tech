{% extends 'admin/layout.html.twig' %}

{% block admin_content %}
    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <h1 class="h2">Events</h1>
        <div class="btn-toolbar mb-2 mb-md-0">
            <div class="btn-group me-2">
                <button type="button" class="btn btn-sm btn-outline-secondary">Export</button>
            </div>
        </div>
    </div>

    <!-- Events Carousel Section -->
    <div class="carousel-wrapper">
        {% if events|length > 0 %}
            <div class="carousel-header">
                <h5 class="events-heading display-6 mb-0"><i class="fas fa-calendar-alt me-2"></i>All Events</h5>
                <span class="badge bg-primary events-count">{{ events|length }} Events</span>
            </div>
            
            <div class="events-grid">
                {% for event in events %}
                    <div class="event-card-container" data-event-id="{{ event.ID }}">
                        <div class="card event-card">
                            <div class="card-body">
                                <div class="card-header-area">
                                    {% if event.type == 'TERRAIN' %}
                                        <div class="event-icon"><i class="fas fa-volleyball-ball"></i></div>
                                    {% elseif event.type == 'PADDEL' %}
                                        <div class="event-icon"><i class="fas fa-table-tennis"></i></div>
                                    {% else %}
                                        <div class="event-icon"><i class="fas fa-calendar-alt"></i></div>
                                    {% endif %}
                                    <h5 class="event-title">{{ event.nom }}</h5>
                                </div>
                                
                                <div class="event-info">
                                    <div class="event-id">
                                        <span class="info-label"><i class="fas fa-hashtag"></i> ID:</span>
                                        <span class="info-value">{{ event.ID }}</span>
                                    </div>
                                    
                                    <div class="event-date">
                                        {% if event.dateDebut %}
                                            <span class="info-label"><i class="far fa-calendar-alt"></i> Date:</span>
                                            <span class="info-value">{{ event.dateDebut|date('d M Y') }}</span>
                                        {% endif %}
                                    </div>
                                    
                                    <div class="event-type">
                                        <span class="info-label"><i class="fas fa-tag"></i> Type:</span>
                                        <span class="info-value">{{ event.type ?: 'N/A' }}</span>
                                    </div>
                                    
                                    {% if event.participantsMax %}
                                        <div class="event-participants">
                                            <span class="info-label"><i class="fas fa-users"></i> Max:</span>
                                            <span class="info-value">{{ event.participantsMax }}</span>
                                        </div>
                                    {% endif %}
                                </div>
                                
                                {% if event.statut %}
                                    <div class="event-status 
                                        {% if event.statut == 'En cours' %}status-active
                                        {% elseif event.statut == 'Terminé' %}status-complete
                                        {% elseif event.statut == 'Annulé' %}status-cancelled
                                        {% endif %}">
                                        <span>{{ event.statut }}</span>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
            
            <!-- Navigation -->
            <div class="d-flex justify-content-center mt-4">
                <nav aria-label="Event navigation">
                  <ul class="pagination">
                    <li class="page-item">
                      <a class="page-link" href="#" aria-label="Previous">
                        <span aria-hidden="true">&laquo;</span>
                      </a>
                    </li>
                    <li class="page-item active"><a class="page-link" href="#">1</a></li>
                    <li class="page-item"><a class="page-link" href="#">2</a></li>
                    <li class="page-item"><a class="page-link" href="#">3</a></li>
                    <li class="page-item">
                      <a class="page-link" href="#" aria-label="Next">
                        <span aria-hidden="true">&raquo;</span>
                      </a>
                    </li>
                  </ul>
                </nav>
            </div>
            
            <!-- Add Event Button -->
            <div class="add-event-container">
                <a href="#" class="btn btn-success add-event-btn">
                    <i class="fas fa-plus-circle me-2"></i> Add New Event
                </a>
                <span class="helper-text">Click on a card to view details</span>
            </div>
            
            <!-- Event Details Section -->
            <div id="eventDetails" class="mt-4">
                <div class="card detail-card">
                    <div class="card-header">
                        <h4 id="selectedEventTitle">Select an event to view details</h4>
                    </div>
                    <div class="card-body">
                        <div id="eventDetailsContent">
                            <div class="text-center text-muted">
                                <i class="fas fa-hand-pointer fa-3x mb-3"></i>
                                <p>Click on a card to view event details</p>
                            </div>
                        </div>
                        
                        <div id="eventActions" class="mt-3 d-none">
                            <div class="d-flex flex-wrap gap-2">
                                <a id="addTicketsBtn" href="#" class="btn btn-primary">
                                    <i class="fas fa-ticket-alt me-1"></i> Add Tickets
                                </a>
                                <a id="setActiveBtn" href="#" class="btn btn-success">
                                    <i class="fas fa-check-circle me-1"></i> Set Status to "En cours"
                                </a>
                                <a id="setCancelledBtn" href="#" class="btn btn-danger">
                                    <i class="fas fa-times-circle me-1"></i> Set Status to "Annulé"
                                </a>
                                <a id="setCompletedBtn" href="#" class="btn btn-warning">
                                    <i class="fas fa-flag-checkered me-1"></i> Set Status to "Terminé"
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Custom styles for the events grid -->
            <style>
                .carousel-wrapper {
                    padding: 20px 0;
                    position: relative;
                    width: 100%;
                    max-width: 1200px;
                    margin: 0 auto;
                }
                
                .carousel-header {
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                    margin-bottom: 20px;
                    padding: 0 20px;
                }
                
                .events-heading {
                    color: #334;
                    font-weight: 600;
                }
                
                .events-count {
                    font-size: 14px;
                    padding: 8px 15px;
                }
                
                .events-grid {
                    display: grid;
                    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
                    gap: 20px;
                    padding: 20px;
                    background: #f8f9fa;
                    border-radius: 10px;
                    border: 1px solid #dee2e6;
                }
                
                .event-card-container {
                    cursor: pointer;
                    transition: transform 0.3s;
                }
                
                .event-card-container:hover {
                    transform: translateY(-5px);
                }
                
                .event-card {
                    height: 100%;
                    border-radius: 10px;
                    border: none;
                    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
                    transition: all 0.3s;
                }
                
                .event-card:hover {
                    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
                }
                
                .selected-card {
                    box-shadow: 0 0 0 3px #3d7cff, 0 10px 25px rgba(0, 0, 0, 0.3) !important;
                }
                
                .card-body {
                    padding: 16px;
                    display: flex;
                    flex-direction: column;
                    height: 100%;
                }
                
                .card-header-area {
                    text-align: center;
                    padding-bottom: 12px;
                    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
                    margin-bottom: 12px;
                }
                
                .event-icon {
                    font-size: 32px;
                    margin-bottom: 10px;
                    color: #3d7cff;
                }
                
                .event-title {
                    font-size: 18px;
                    font-weight: bold;
                    margin: 0;
                    height: 44px;
                    overflow: hidden;
                    display: -webkit-box;
                    -webkit-line-clamp: 2;
                    -webkit-box-orient: vertical;
                }
                
                .event-info {
                    flex-grow: 1;
                    font-size: 14px;
                    color: #555;
                    display: flex;
                    flex-direction: column;
                    gap: 8px;
                    margin: 10px 0;
                }
                
                .event-id, .event-date, .event-type, .event-participants {
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                }
                
                .info-label {
                    font-weight: 600;
                }
                
                .info-value {
                    text-align: right;
                }
                
                .event-status {
                    text-align: center;
                    padding: 6px;
                    border-radius: 4px;
                    font-weight: bold;
                    font-size: 14px;
                    margin-top: 10px;
                }
                
                .status-active {
                    background-color: rgba(40, 167, 69, 0.2);
                    color: #28a745;
                }
                
                .status-complete {
                    background-color: rgba(0, 123, 255, 0.2);
                    color: #007bff;
                }
                
                .status-cancelled {
                    background-color: rgba(220, 53, 69, 0.2);
                    color: #dc3545;
                }
                
                .add-event-container {
                    display: flex;
                    justify-content: center;
                    align-items: center;
                    gap: 20px;
                    margin: 20px 0;
                }
                
                .add-event-btn {
                    padding: 10px 20px;
                    border-radius: 25px;
                    font-weight: 500;
                    font-size: 16px;
                    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.15);
                    transition: all 0.2s;
                }
                
                .add-event-btn:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
                }
                
                .helper-text {
                    font-size: 14px;
                    color: #666;
                }
                
                .detail-card {
                    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
                    border: none;
                    border-radius: 8px;
                    overflow: hidden;
                }
                
                .detail-card .card-header {
                    background: linear-gradient(90deg, #3d7cff, #56a8fd);
                    color: white;
                    padding: 15px 20px;
                    border: none;
                }
                
                /* Pagination styling */
                .pagination .page-link {
                    color: #3d7cff;
                    border-color: #dee2e6;
                }
                
                .pagination .page-item.active .page-link {
                    background-color: #3d7cff;
                    border-color: #3d7cff;
                }
                
                /* Responsive adjustments */
                @media (max-width: 768px) {
                    .events-grid {
                        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
                    }
                    
                    .event-title {
                        font-size: 16px;
                        height: 40px;
                    }
                    
                    .event-info {
                        font-size: 12px;
                        gap: 6px;
                    }
                }
                
                @media (max-width: 576px) {
                    .events-grid {
                        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
                    }
                    
                    .event-icon {
                        font-size: 24px;
                    }
                    
                    .event-title {
                        font-size: 14px;
                        height: 36px;
                    }
                }
            </style>
            
            <!-- JavaScript for event card selection and detail display -->
            <script>
                document.addEventListener('DOMContentLoaded', function() {
                    const eventCards = document.querySelectorAll('.event-card-container');
                    const eventDetailsContent = document.getElementById('eventDetailsContent');
                    const eventTitle = document.getElementById('selectedEventTitle');
                    const eventActions = document.getElementById('eventActions');
                    const addTicketsBtn = document.getElementById('addTicketsBtn');
                    const setActiveBtn = document.getElementById('setActiveBtn');
                    const setCancelledBtn = document.getElementById('setCancelledBtn');
                    const setCompletedBtn = document.getElementById('setCompletedBtn');
                    
                    eventCards.forEach(card => {
                        card.addEventListener('click', function() {
                            // Remove selected class from all cards
                            eventCards.forEach(c => c.querySelector('.event-card').classList.remove('selected-card'));
                            
                            // Add selected class to clicked card
                            this.querySelector('.event-card').classList.add('selected-card');
                            
                            // Get event ID
                            const eventId = this.dataset.eventId;
                            
                            // Set event title
                            const eventName = this.querySelector('.event-title').textContent;
                            eventTitle.textContent = eventName + ' (ID: ' + eventId + ')';
                            
                            // Show event details
                            const eventType = this.querySelector('.event-type .info-value').textContent;
                            const eventDate = this.querySelector('.event-date .info-value')?.textContent || 'Not set';
                            const eventStatus = this.querySelector('.event-status')?.textContent.trim() || 'Not set';
                            const eventParticipants = this.querySelector('.event-participants .info-value')?.textContent || 'Not set';
                            
                            eventDetailsContent.innerHTML = `
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <h6><i class="fas fa-id-card me-2"></i> ID:</h6>
                                            <p>${eventId}</p>
                                        </div>
                                        <div class="mb-3">
                                            <h6><i class="fas fa-calendar-alt me-2"></i> Start Date:</h6>
                                            <p>${eventDate}</p>
                                        </div>
                                        <div class="mb-3">
                                            <h6><i class="fas fa-tag me-2"></i> Type:</h6>
                                            <p>${eventType}</p>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <h6><i class="fas fa-info-circle me-2"></i> Status:</h6>
                                            <p><span class="badge ${eventStatus === 'En cours' ? 'bg-success' : eventStatus === 'Annulé' ? 'bg-danger' : 'bg-warning'}">${eventStatus}</span></p>
                                        </div>
                                        <div class="mb-3">
                                            <h6><i class="fas fa-users me-2"></i> Max Participants:</h6>
                                            <p>${eventParticipants}</p>
                                        </div>
                                        <div class="mb-3">
                                            <h6><i class="fas fa-ticket-alt me-2"></i> Tickets:</h6>
                                            <p>Configure tickets using the buttons below</p>
                                        </div>
                                    </div>
                                </div>
                            `;
                            
                            // Show action buttons
                            eventActions.classList.remove('d-none');
                            
                            // Update button links
                            addTicketsBtn.href = "{{ path('admin_event_add_tickets', {'id': '0'}) }}".replace('0', eventId);
                            setActiveBtn.href = "{{ path('admin_event_update_status', {'id': '0', 'status': 'En cours'}) }}".replace('0', eventId);
                            setCancelledBtn.href = "{{ path('admin_event_update_status', {'id': '0', 'status': 'Annulé'}) }}".replace('0', eventId);
                            setCompletedBtn.href = "{{ path('admin_event_update_status', {'id': '0', 'status': 'Terminé'}) }}".replace('0', eventId);
                            
                            // Scroll to event details
                            document.getElementById('eventDetails').scrollIntoView({behavior: 'smooth'});
                        });
                    });
                });
            </script>
        {% else %}
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i> No events found.
            </div>
        {% endif %}
    </div>
{% endblock %} 