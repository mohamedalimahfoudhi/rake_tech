{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200">
    <link rel="stylesheet" href="{{ asset('assets/styles/admin-auth.css') }}">
{% endblock %}

{% block body %}
    <div class="admin-container">
        <div class="sidebar">
            <div class="sidebar-header">
                <a href="{{ path('admin_dashboard') }}" class="logo">
                    <span class="logo-racket">🎾</span>
                    <span class="logo-text">RackeTech</span>
                </a>
                <p>Welcome, {{ app.user.prenom|default('Admin') }}</p>
            </div>
            <div class="sidebar-menu">
                <ul>
                    <li>
                        <a href="{{ path('admin_dashboard') }}" class="{% if app.request.get('_route') == 'admin_dashboard' %}active{% endif %}">
                            <i class='bx bxs-dashboard'></i> <span>Dashboard</span>
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('admin_events') }}" class="{% if app.request.get('_route') == 'admin_events' %}active{% endif %}">
                            <i class='bx bxs-calendar-event'></i> <span>Events</span>
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('admin_tickets') }}" class="{% if app.request.get('_route') == 'admin_tickets' %}active{% endif %}">
                            <i class='bx bxs-ticket'></i> <span>Tickets</span>
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('exchange_rates') }}" class="{% if app.request.get('_route') starts with 'exchange_rates' %}active{% endif %}">
                            <i class='bx bx-money-withdraw'></i> <span>Exchange Rates</span>
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('cart_index') }}" class="{% if app.request.get('_route') == 'cart_index' %}active{% endif %}">
                            <i class='bx bxs-cart'></i> <span>Price Calculator ({{ app.session.get('cart')|length|default(0) }})</span>
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('app_logout') }}">
                            <i class='bx bxs-log-out'></i> <span>Logout</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <div class="main-content">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label }} mb-4">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}
            
            {% block admin_content %}{% endblock %}
        </div>
    </div>
{% endblock %} 