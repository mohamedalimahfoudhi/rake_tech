<!-- Edit Modal for Ticket ID: {{ ticket.ID }} -->
<div class="modal fade" id="editTicketModal_{{ ticket.ID }}" tabindex="-1" aria-labelledby="editTicketModalLabel_{{ ticket.ID }}" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title" id="editTicketModalLabel_{{ ticket.ID }}">Edit Ticket (ID: {{ ticket.ID }})</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" action="{{ path('admin_ticket_edit', {'id': ticket.ID}) }}" class="needs-validation" novalidate>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="edit_event_{{ ticket.ID }}" class="form-label">Event</label>
                        <select class="form-select" id="edit_event_{{ ticket.ID }}" name="eventID" required>
                            {% for event in events %}
                                <option value="{{ event.ID }}" {% if ticket.evenement and ticket.evenement.ID == event.ID %}selected{% endif %}>
                                    {{ event.nom }}
                                </option>
                            {% endfor %}
                        </select>
                        <div class="invalid-feedback">
                            Please select an event.
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="edit_type_{{ ticket.ID }}" class="form-label">Ticket Type</label>
                        <select class="form-select" id="edit_type_{{ ticket.ID }}" name="typeBillet" required>
                            <option value="Gradin" {% if ticket.typeBillet == 'Gradin' %}selected{% endif %}>Gradin</option>
                            <option value="Virage" {% if ticket.typeBillet == 'Virage' %}selected{% endif %}>Virage</option>
                            <option value="VIP" {% if ticket.typeBillet == 'VIP' %}selected{% endif %}>VIP</option>
                        </select>
                        <div class="invalid-feedback">
                            Please select a ticket type.
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="edit_price_{{ ticket.ID }}" class="form-label">Price</label>
                        <div class="input-group has-validation">
                            <span class="input-group-text">$</span>
                            <input type="number" class="form-control" id="edit_price_{{ ticket.ID }}" name="prix" value="{{ ticket.prix|number_format(2, '.', '') }}" min="0" step="0.01" required>
                            <div class="invalid-feedback">
                                Please enter a valid price (minimum $0).
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="edit_quantity_{{ ticket.ID }}" class="form-label">Quantity</label>
                        <input type="number" class="form-control" id="edit_quantity_{{ ticket.ID }}" name="quantite" value="{{ ticket.quantite }}" min="1" required>
                        <div class="invalid-feedback">
                            Please enter a valid quantity (minimum 1).
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="edit_status_{{ ticket.ID }}" class="form-label">Status</label>
                        <select class="form-select" id="edit_status_{{ ticket.ID }}" name="statut" required>
                            <option value="Valide" {% if ticket.statut == 'Valide' %}selected{% endif %}>Valide</option>
                            <option value="Annulé" {% if ticket.statut == 'Annulé' %}selected{% endif %}>Annulé</option>
                            <option value="Non valide" {% if ticket.statut == 'Non valide' %}selected{% endif %}>Non valide</option>
                        </select>
                        <div class="invalid-feedback">
                            Please select a status.
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div> 