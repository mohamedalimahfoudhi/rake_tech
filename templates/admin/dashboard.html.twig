{% extends 'admin/layout.html.twig' %}

{% block admin_content %}
    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <h1 class="h2">Admin Dashboard</h1>
        <div class="btn-toolbar mb-2 mb-md-0">
            <div class="btn-group me-2">
                <button type="button" class="btn btn-sm btn-outline-secondary">Export</button>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card bg-primary text-white mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="mb-0">{{ event_count ?? 0 }}</h5>
                            <div class="small">Total Events</div>
                        </div>
                        <i class="fas fa-calendar-alt fa-2x opacity-50"></i>
                    </div>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between">
                    <a class="small text-white stretched-link" href="{{ path('admin_events') }}">View Events</a>
                    <div class="small text-white"><i class="fas fa-angle-right"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card bg-success text-white mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="mb-0">{{ ticket_count ?? 0 }}</h5>
                            <div class="small">Total Tickets</div>
                        </div>
                        <i class="fas fa-ticket-alt fa-2x opacity-50"></i>
                    </div>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between">
                    <a class="small text-white stretched-link" href="{{ path('admin_tickets') }}">Manage Tickets</a>
                    <div class="small text-white"><i class="fas fa-angle-right"></i></div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-lg-6">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fas fa-calendar-alt me-1"></i>
                    Recent Events
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Name</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% if recent_events is defined %}
                                    {% for event in recent_events %}
                                        <tr>
                                            <td>{{ event.ID }}</td>
                                            <td>{{ event.nom }}</td>
                                            <td>
                                                {% if event.dateDebut %}
                                                    {{ event.dateDebut|date('Y-m-d') }}
                                                {% else %}
                                                    N/A
                                                {% endif %}
                                            </td>
                                            <td>{{ event.statut ?: 'N/A' }}</td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="4" class="text-center">No events found</td>
                                        </tr>
                                    {% endfor %}
                                {% else %}
                                    <tr>
                                        <td colspan="4" class="text-center">No events data available</td>
                                    </tr>
                                {% endif %}
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer small text-muted">
                    <a href="{{ path('admin_events') }}" class="btn btn-sm btn-primary">View All Events</a>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fas fa-ticket-alt me-1"></i>
                    Recent Tickets
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Type</th>
                                    <th>Price</th>
                                    <th>Event</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% if recent_tickets is defined %}
                                    {% for ticket in recent_tickets %}
                                        <tr>
                                            <td>{{ ticket.ID }}</td>
                                            <td>{{ ticket.typeBillet }}</td>
                                            <td>{{ ticket.prix }}</td>
                                            <td>
                                                {% if ticket.event %}
                                                    {{ ticket.event.nom }}
                                                {% else %}
                                                    N/A
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="4" class="text-center">No tickets found</td>
                                        </tr>
                                    {% endfor %}
                                {% else %}
                                    <tr>
                                        <td colspan="4" class="text-center">No tickets data available</td>
                                    </tr>
                                {% endif %}
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer small text-muted">
                    <a href="{{ path('admin_tickets') }}" class="btn btn-sm btn-primary">Manage Tickets</a>
                </div>
            </div>
        </div>
    </div>
    
    <div class="row mt-4">
        <div class="col-12">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fas fa-bookmark me-1"></i>
                    Ticket Reservations Overview
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>Reservation ID</th>
                                    <th>Ticket ID</th>
                                    <th>Number of Tickets</th>
                                    <th>Ticket Type</th>
                                    <th>Event</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% if recent_reservations is defined %}
                                    {% for reservation in recent_reservations %}
                                        <tr>
                                            <td>{{ reservation.reservationID }}</td>
                                            <td>{{ reservation.billetID }}</td>
                                            <td>{{ reservation.nombreBillet }}</td>
                                            <td>
                                                {% if reservation.billet %}
                                                    {{ reservation.billet.typeBillet }}
                                                {% else %}
                                                    N/A
                                                {% endif %}
                                            </td>
                                            <td>
                                                {% if reservation.billet and reservation.billet.event %}
                                                    {{ reservation.billet.event.nom }}
                                                {% else %}
                                                    N/A
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="5" class="text-center">No reservations found</td>
                                        </tr>
                                    {% endfor %}
                                {% else %}
                                    <tr>
                                        <td colspan="5" class="text-center">No reservation data available</td>
                                    </tr>
                                {% endif %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %} 