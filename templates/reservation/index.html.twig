{% extends 'base.html.twig' %}

{% block title %}Liste des Réservations{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <!-- Sidebar -->
        <nav class="col-md-3 col-lg-2 d-md-block bg-light sidebar">
            <div class="position-sticky pt-3">
                <!-- Logo and User Info -->
                <div class="text-center mb-4">
                    <div class="logo mb-3">
                        <span class="logo-racket">🎾</span>
                        <span class="logo-text">RackeTech</span>
                    </div>
                    <div class="dropdown">
                        <a class="dropdown-toggle text-dark text-decoration-none" href="#" role="button"
                            id="userDropdown" data-bs-toggle="dropdown">
                            <i class="fas fa-user-circle me-1"></i> {{ app.user.prenom }}
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="{{ path('app_profile') }}">Profile</a></li>
                            <li>
                                <hr class="dropdown-divider">
                            </li>
                            <li><a class="dropdown-item" href="{{ path('app_logout') }}">Logout</a></li>
                        </ul>
                    </div>
                </div>

                <!-- Navigation -->
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_dashboard') }}">
                            <i class="fas fa-tachometer-alt"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_user_management') }}">
                            <i class="fas fa-users"></i> User Management
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link " href="{{ path('app_emprunt_index') }}">
                            <i class="fas fa-users"></i> Emprunt Management
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link " href="{{ path('app_materiel_index') }}">
                            <i class="fas fa-users"></i> Materiels Management
                        </a>
                    </li>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link  " href="{{ path('app_tournoi_index') }}">
                            <i class="fas fa-users"></i> Tournoi Management
                        </a>
                    </li>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active " href="{{ path('app_reservation_index') }}">
                            <i class="fas fa-users"></i> Reservation Management
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link  " href="{{ path('app_maintenance_index') }}">
                            <i class="fas fa-users"></i> Maintenance Management
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_event_index') }}" class="nav-link">
                            <i class="fas fa-calendar"></i>
                            Events
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_terrain_index') }}" class="nav-link">
                            <i class="fas fa-map"></i>
                            Terrains
                        </a>
                    </li>
                    {# <li class="nav-item">
                        <a href="{{ path('app_mapb') }}" class="nav-link">
                            <i class="fas fa-map"></i>
                            Carte des terrains
                        </a>
                    </li> #}
                    <li class="nav-item">
                        <a href="{{ path('calb') }}" class="nav-link">
                            <i class="fas fa-calendar"></i>
                            Calendar Events
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            <i class="fas fa-cog"></i> Settings
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            <i class="fas fa-chart-bar"></i> Reports
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            <i class="fas fa-bell"></i> Notifications
                        </a>
                    </li>
                </ul>
            </div>
        </nav>

        <!-- Main content -->
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div
                class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2">Reservation Management</h1>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <div class="btn-group me-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary">Export</button>
                    </div>
                    <div class="btn-group me-2">
                        <a href="{{ path('app_reservation_new') }}" class="btn btn-primary">
                            <i class="fas fa-plus"></i> Nouvelle Reservation
                        </a>
                    </div>



                </div>
            </div>

            {% for message in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
            {% endfor %}

            {% for message in app.flashes('error') %}
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
            {% endfor %}
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th class=" text-white">Date</th>
                                <th class=" text-white">Type</th>
                                <th class=" text-white">Statut</th>
                                <th class=" text-white">Utilisateur</th>
                                <th class=" text-white" style="width: 150px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for reservation in reservations %}
                            <tr>
                                <td >{{ reservation.dateReservation|date('d/m/Y H:i') }}</td>
                                <td >
                                    {% if reservation.type == 'TERRAIN' %}
                                    <span >TERRAIN</span>
                                    {% elseif reservation.type == 'BILLET' %}
                                    <span >BILLET</span>
                                    {% elseif reservation.type is null %}
                                    <span >Non défini</span>
                                    {% else %}
                                    <span >{{ reservation.type }}</span>
                                    {% endif %}
                                </td>
                                <td >
                                    {% if reservation.statut == 'Confirmée' %}
                                    <span >Confirmée</span>
                                    {% elseif reservation.statut == 'En attente' %}
                                    <span >En attente</span>
                                    {% elseif reservation.statut == 'Annulée' %}
                                    <span >Annulée</span>
                                    {% else %}
                                    <span >{{ reservation.statut }}</span>
                                    {% endif %}
                                </td>
                                <td class="bg-light">
                                    {% if reservation.utilisateurid %}
                                    {{ reservation.utilisateurid }}
                                    {% else %}
                                    <span class="text-muted">Non défini</span>
                                    {% endif %}
                                </td>
                                <td >
                                    <div class="btn-group">
                                        <a href="{{ path('app_reservation_show', {'id': reservation.id}) }}"
                                            class="btn btn-sm btn-info" title="Voir">
                                            <i class="ri-eye-line"></i>
                                        </a>
                                        <a href="{{ path('app_reservation_edit', {'id': reservation.id}) }}"
                                            class="btn btn-sm btn-warning" title="Modifier">
                                            <i class="ri-edit-line"></i>
                                        </a>
                                        <form method="post"
                                            action="{{ path('app_reservation_delete', {'id': reservation.id}) }}"
                                            onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette réservation ?');"
                                            style="display: inline-block;">
                                            <input type="hidden" name="_token"
                                                value="{{ csrf_token('delete' ~ reservation.id) }}">
                                            <button class="btn btn-sm btn-danger" title="Supprimer">
                                                <i class="ri-delete-bin-line"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="6" class="text-center bg-light">Aucune réservation trouvée</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
    </div>
</div>
{% endblock %}