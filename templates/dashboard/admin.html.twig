{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard - RackeTech{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    /* Custom styles for user dropdown */
    .user-dropdown {
        cursor: pointer;
        position: relative;
        display: inline-block;
    }
    .user-dropdown-content {
        display: none;
        position: absolute;
        background-color: #f9f9f9;
        min-width: 160px;
        box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);
        z-index: 1;
        text-align: left;
        border-radius: 4px;
    }
    .user-dropdown-content a {
        color: black;
        padding: 12px 16px;
        text-decoration: none;
        display: block;
    }
    .show {
        display: block !important;
    }
    .user-dropdown-content a:hover {
        background-color: #f1f1f1;
    }
    .user-dropdown-divider {
        height: 1px;
        margin: 0;
        overflow: hidden;
        background-color: #e9ecef;
    }
</style>
{% endblock %}

{% block body %}
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <nav class="col-md-3 col-lg-2 d-md-block bg-light sidebar">
                <div class="position-sticky pt-3">
                    <!-- Logo and User Info -->
                    <div class="text-center mb-4">
                        <div class="logo mb-3">
                            <span class="logo-racket">🎾</span>
                            <span class="logo-text">RackeTech</span>
                        </div>
                        <!-- Custom Dropdown Implementation -->
                        <div class="user-dropdown">
                            <div onclick="toggleUserDropdown()" class="btn btn-sm btn-light" id="userDropdownBtn">
                                <i class="fas fa-user-circle me-1"></i> {{ app.user.prenom }} <i class="fas fa-caret-down"></i>
                            </div>
                            <div id="userDropdownContent" class="user-dropdown-content">
                                <a href="{{ path('app_profile') }}">Profile</a>
                                <div class="user-dropdown-divider"></div>
                                <a href="{{ path('app_logout') }}">Logout</a>
                            </div>
                        </div>
                    </div>

                    <!-- Navigation -->
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link active" href="{{ path('app_dashboard') }}">
                                <i class="fas fa-tachometer-alt"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_user_management') }}">
                                <i class="fas fa-users"></i> User Management
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_emprunt_index') }}">
                                <i class="fas fa-handshake"></i> Emprunt Management
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_materiel_index') }}">
                                <i class="fas fa-toolbox"></i> Materiels Management
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_tournoi_index') }}">
                                <i class="fas fa-trophy"></i> Tournoi Management
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_reservation_index') }}">
                                <i class="fas fa-calendar-check"></i> Reservation Management
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_maintenance_index') }}">
                                <i class="fas fa-wrench"></i> Maintenance Management
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <i class="fas fa-cog"></i> Settings
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <i class="fas fa-chart-bar"></i> Reports
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <i class="fas fa-bell"></i> Notifications
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>

            <!-- Main content -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2">Admin Dashboard</h1>
                </div>

                <!-- Welcome Section -->
                <div class="row mb-4">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">Welcome, {{ app.user.prenom }}!</h5>
                                <p class="card-text">Manage your platform from this dashboard.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Quick Stats -->
                <div class="row">
                    <div class="col-md-3 mb-4">
                        <div class="card text-white bg-primary">
                            <div class="card-body">
                                <h5 class="card-title">Total Users</h5>
                                <p class="card-text display-4">0</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 mb-4">
                        <div class="card text-white bg-success">
                            <div class="card-body">
                                <h5 class="card-title">Active Events</h5>
                                <p class="card-text display-4">0</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 mb-4">
                        <div class="card text-white bg-warning">
                            <div class="card-body">
                                <h5 class="card-title">Organizers</h5>
                                <p class="card-text display-4">0</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 mb-4">
                        <div class="card text-white bg-info">
                            <div class="card-body">
                                <h5 class="card-title">Athletes</h5>
                                <p class="card-text display-4">0</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Recent Activity -->
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h5 class="card-title mb-0">Recent Activity</h5>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-striped">
                                        <thead>
                                            <tr>
                                                <th>Date</th>
                                                <th>User</th>
                                                <th>Action</th>
                                                <th>Details</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td colspan="4" class="text-center">No recent activity</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    // Custom dropdown toggle function
    function toggleUserDropdown() {
        document.getElementById("userDropdownContent").classList.toggle("show");
    }

    // Close the dropdown if clicked outside
    window.onclick = function(event) {
        if (!event.target.matches('#userDropdownBtn') && !event.target.parentNode.matches('#userDropdownBtn')) {
            var dropdowns = document.getElementsByClassName("user-dropdown-content");
            for (var i = 0; i < dropdowns.length; i++) {
                var openDropdown = dropdowns[i];
                if (openDropdown.classList.contains('show')) {
                    openDropdown.classList.remove('show');
                }
            }
        }
    }

    // Add this to ensure the dropdown works immediately
    document.addEventListener('DOMContentLoaded', function() {
        var userDropdownBtn = document.getElementById('userDropdownBtn');
        if (userDropdownBtn) {
            userDropdownBtn.addEventListener('click', function(event) {
                event.stopPropagation();
                toggleUserDropdown();
            });
        }
    });
</script>
{% endblock %}