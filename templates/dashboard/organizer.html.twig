{% extends 'base.html.twig' %}

{% block title %}Organizer Dashboard - RackeTech{% endblock %}

{% block body %}
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h1 class="mb-4">Organizer Dashboard</h1>
                
                <!-- Welcome Section -->
                <div class="card mb-4">
                    <div class="card-body">
                        <h2 class="card-title">Welcome, {{ app.user.prenom }}!</h2>
                        <p class="card-text">Manage your events and participants from this dashboard.</p>
                    </div>
                </div>

                <!-- Quick Stats -->
                <div class="row mb-4">
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">Total Events</h5>
                                <p class="card-text display-4">0</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">Active Events</h5>
                                <p class="card-text display-4">0</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">Total Participants</h5>
                                <p class="card-text display-4">0</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Recent Events -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Recent Events</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Event Name</th>
                                        <th>Date</th>
                                        <th>Participants</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td colspan="4" class="text-center">No events found</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Quick Actions -->
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Quick Actions</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4">
                                <a href="#" class="btn btn-primary w-100 mb-3">
                                    <i class="fas fa-plus-circle me-2"></i>Create New Event
                                </a>
                            </div>
                            <div class="col-md-4">
                                <a href="#" class="btn btn-secondary w-100 mb-3">
                                    <i class="fas fa-tasks me-2"></i>Manage Events
                                </a>
                            </div>
                            <div class="col-md-4">
                                <a href="#" class="btn btn-info w-100 mb-3">
                                    <i class="fas fa-users me-2"></i>Manage Participants
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %} 