{% extends 'base.html.twig' %}

{% block title %}User Dashboard - RackeTech{% endblock %}

{% block body %}
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h1 class="mb-4">User Dashboard</h1>
                
                <!-- Welcome Section -->
                <div class="card mb-4">
                    <div class="card-body">
                        <h2 class="card-title">Welcome, {{ app.user.prenom }}!</h2>
                        <p class="card-text">Explore and participate in tennis events from this dashboard.</p>
                    </div>
                </div>

                <!-- Quick Stats -->
                <div class="row mb-4">
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">Events Attended</h5>
                                <p class="card-text display-4">0</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">Upcoming Events</h5>
                                <p class="card-text display-4">0</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">Favorite Courts</h5>
                                <p class="card-text display-4">0</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Available Events -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Available Events</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Event Name</th>
                                        <th>Date</th>
                                        <th>Location</th>
                                        <th>Type</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td colspan="4" class="text-center">No events available</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Quick Actions -->
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Quick Actions</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4">
                                <a href="#" class="btn btn-primary w-100 mb-3">
                                    <i class="fas fa-calendar-alt me-2"></i>Browse Events
                                </a>
                            </div>
                            <div class="col-md-4">
                                <a href="#" class="btn btn-secondary w-100 mb-3">
                                    <i class="fas fa-map-marker-alt me-2"></i>Find Courts
                                </a>
                            </div>
                            <div class="col-md-4">
                                <a href="#" class="btn btn-info w-100 mb-3">
                                    <i class="fas fa-user-friends me-2"></i>Find Players
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %} 