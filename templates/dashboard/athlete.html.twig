{% extends 'base.html.twig' %}

{% block title %}Athlete Dashboard - RackeTech{% endblock %}

{% block body %}
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h1>Athlete Dashboard</h1>
                    <a href="{{ path('app_logout') }}" class="btn btn-danger">
                        <i class="fas fa-sign-out-alt me-2"></i>Logout
                    </a>
                </div>
                
                <!-- Welcome Section -->
                <div class="card mb-4">
                    <div class="card-body">
                        <h2 class="card-title">Welcome, {{ app.user.prenom }}!</h2>
                        <p class="card-text">Track your events and performance from this dashboard.</p>
                    </div>
                </div>

                <!-- Quick Stats -->
                <div class="row mb-4">
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">Upcoming Events</h5>
                                <p class="card-text display-4">0</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">Completed Events</h5>
                                <p class="card-text display-4">0</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">Total Points</h5>
                                <p class="card-text display-4">0</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Upcoming Events -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Upcoming Events</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Event Name</th>
                                        <th>Date</th>
                                        <th>Location</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td colspan="4" class="text-center">No upcoming events</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Quick Actions -->
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Quick Actions</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-3">
                                <a href="#" class="btn btn-primary w-100 mb-3">
                                    <i class="fas fa-calendar-alt me-2"></i>View Events
                                </a>
                            </div>
                            <div class="col-md-3">
                                <a href="{{ path('app_athlete_tickets') }}" class="btn btn-success w-100 mb-3">
                                    <i class="fas fa-ticket-alt me-2"></i>My Tickets
                                </a>
                            </div>
                            <div class="col-md-3">
                                <a href="#" class="btn btn-secondary w-100 mb-3">
                                    <i class="fas fa-chart-line me-2"></i>Performance Stats
                                </a>
                            </div>
                            <div class="col-md-3">
                                <a href="{{ path('app_logout') }}" class="btn btn-danger w-100 mb-3">
                                    <i class="fas fa-sign-out-alt me-2"></i>Logout
                                </a>
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-md-3">
                                <a href="#" class="btn btn-info w-100 mb-3">
                                    <i class="fas fa-trophy me-2"></i>Achievements
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %} 