{% extends 'base.html.twig' %}

{% block title %}User Management{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .search-container {
        position: relative;
    }

    .search-results {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        z-index: 1000;
        background: white;
        border: 1px solid #ddd;
        border-radius: 4px;
        max-height: 300px;
        overflow-y: auto;
        display: none;
    }

    .search-results.active {
        display: block;
    }
    
    .pagination {
        justify-content: center;
        margin-top: 20px;
    }
    
    .page-navigation {
        display: flex;
        justify-content: center;
        align-items: center;
        margin-top: 20px;
    }
    
    .page-info {
        margin: 0 15px;
    }
    
    .pagination-controls {
        margin-bottom: 15px;
    }
</style>
{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <!-- Sidebar -->
        <nav class="col-md-3 col-lg-2 d-md-block bg-light sidebar">
            <div class="position-sticky pt-3">
                <!-- Logo and User Info -->
                <div class="text-center mb-4">
                    <div class="logo mb-3">
                        <span class="logo-racket">🎾</span>
                        <span class="logo-text">RackeTech</span>
                    </div>
                    <div class="dropdown">
                        <a class="dropdown-toggle text-dark text-decoration-none" href="#" role="button"
                            id="userDropdown" data-bs-toggle="dropdown">
                            <i class="fas fa-user-circle me-1"></i> {{ app.user.prenom }}
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="{{ path('app_profile') }}">Profile</a></li>
                            <li>
                                <hr class="dropdown-divider">
                            </li>
                            <li><a class="dropdown-item" href="{{ path('app_logout') }}">Logout</a></li>
                        </ul>
                    </div>
                </div>

                <!-- Navigation -->
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_dashboard') }}">
                            <i class="fas fa-tachometer-alt"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="{{ path('app_user_management') }}">
                            <i class="fas fa-users"></i> User Management
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_emprunt_index') }}">
                            <i class="fas fa-users"></i> Emprunt Management
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_materiel_index') }}">
                            <i class="fas fa-users"></i> Materiels Management
                        </a>
                    </li>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link  " href="{{ path('app_tournoi_index') }}">
                            <i class="fas fa-users"></i> Tournoi Management
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link  " href="{{ path('app_reservation_index') }}">
                            <i class="fas fa-users"></i> Reservation Management
                        </a>
                    </li>
                   <li class="nav-item">
                            <a class="nav-link  " href="{{ path('app_maintenance_index') }}">
                                <i class="fas fa-users"></i> Maintenance Management
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_ticket_index') }}">
                                <i class="fas fa-ticket-alt"></i> Ticket Management
                            </a>
                        </li>
                             <li class="nav-item">
							<a href="{{ path('app_event_index') }}" class="nav-link">
								<i class="fas fa-calendar"></i>
								Events
							</a>
						</li>
						<li class="nav-item">
							<a href="{{ path('app_terrain_index') }}" class="nav-link">
								<i class="fas fa-map"></i>
								Terrains
							</a>
						</li>
						{# <li class="nav-item">
							<a href="{{ path('app_mapb') }}" class="nav-link">
								<i class="fas fa-map"></i>
								Carte des terrains
							</a>
						</li> #}
						<li class="nav-item">
							<a href="{{ path('calb') }}" class="nav-link">
								<i class="fas fa-calendar"></i>
								Calendar Events
							</a>
						</li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            <i class="fas fa-cog"></i> Settings
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            <i class="fas fa-chart-bar"></i> Reports
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            <i class="fas fa-bell"></i> Notifications
                        </a>
                    </li>
                </ul>
            </div>
        </nav>

        <!-- Main content -->
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="container mt-4">
                <div class="row mb-4">
                    <div class="col-md-6">
                        <h1>User Management</h1>
                    </div>
                    <div class="col-md-6 text-end">
                        <a href="{{ path('app_dashboard') }}" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Back to Dashboard
                        </a>
                        <button id="exportPdf" class="btn btn-danger">
                            <i class="fas fa-file-pdf"></i> Export to PDF
                        </button>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-8">
                        <form method="get" class="search-container d-flex gap-2">
                            <input type="hidden" name="page" value="1">
                            <input type="hidden" name="limit" value="{{ itemsPerPage }}">
                            <div class="flex-grow-1">
                                <input type="text" name="search" id="searchInput" class="form-control"
                                    placeholder="Search users..." value="{{ search }}">
                            </div>
                            <div class="flex-shrink-0" style="width: 200px;">
                                <select name="role" id="roleFilter" class="form-control">
                                    <option value="">All Roles</option>
                                    {% for role in roles %}
                                    <option value="{{ role.roleID }}" {% if selected_role==role.roleID %}selected{%
                                        endif %}>
                                        {{ role.roleNom }}
                                    </option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="flex-shrink-0">
                                <button type="submit" class="btn btn-primary">Filter</button>
                            </div>
                        </form>
                    </div>
                </div>

                {% for message in app.flashes('success') %}
                <div class="alert alert-success">
                    {{ message }}
                </div>
                {% endfor %}

                {% for message in app.flashes('error') %}
                <div class="alert alert-danger">
                    {{ message }}
                </div>
                {% endfor %}
                
                <!-- Pagination Controls -->
                <div class="pagination-controls d-flex justify-content-between align-items-center">
                    <div>
                        <div class="btn-group" role="group">
                            <button type="button" class="btn btn-sm btn-outline-secondary page-size-btn active" data-size="3">3</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary page-size-btn" data-size="10">10</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary page-size-btn" data-size="25">25</button>
                        </div>
                    </div>
                    <div>
                        <span class="badge bg-info">{{ pagination.currentPageNumber }} / {{ totalPages }}</span>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-striped" id="usersTable">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Email</th>
                                <th>First Name</th>
                                <th>Last Name</th>
                                <th>Phone</th>
                                <th>Role</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for user in pagination %}
                            <tr>
                                <td>{{ user.id }}</td>
                                <td>{{ user.email }}</td>
                                <td>{{ user.prenom }}</td>
                                <td>{{ user.nom }}</td>
                                <td>{{ user.numeroTelephone }}</td>
                                <td>{{ user.role.roleNom }}</td>
                                <td>
                                    <a href="{{ path('app_user_edit', {'id': user.id, 'page': pagination.currentPageNumber, 'limit': itemsPerPage, 'role': selected_role, 'search': search}) }}"
                                        class="btn btn-sm btn-primary">Edit</a>
                                    <form method="post" action="{{ path('app_user_delete', {'id': user.id, 'page': pagination.currentPageNumber, 'limit': itemsPerPage, 'role': selected_role, 'search': search}) }}"
                                        class="d-inline"
                                        onsubmit="return confirm('Are you sure you want to delete this user?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                        <button class="btn btn-sm btn-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="7" class="text-center">No users found</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                <!-- Custom Pagination -->
                <div class="page-navigation">
                    <a href="{{ path('app_user_management', {'page': 1, 'limit': itemsPerPage, 'role': selected_role, 'search': search}) }}" 
                       class="btn btn-sm btn-outline-primary {% if pagination.currentPageNumber == 1 %}disabled{% endif %}">
                        <i class="fas fa-angle-double-left"></i>
                    </a>
                    
                    <a href="{{ path('app_user_management', {'page': pagination.currentPageNumber - 1, 'limit': itemsPerPage, 'role': selected_role, 'search': search}) }}" 
                       class="btn btn-sm btn-outline-primary {% if pagination.currentPageNumber == 1 %}disabled{% endif %}">
                        <i class="fas fa-angle-left"></i>
                    </a>
                    
                    <span class="page-info">
                        Page {{ pagination.currentPageNumber }} sur {{ totalPages }}
                    </span>
                    
                    <a href="{{ path('app_user_management', {'page': pagination.currentPageNumber + 1, 'limit': itemsPerPage, 'role': selected_role, 'search': search}) }}" 
                       class="btn btn-sm btn-outline-primary {% if pagination.currentPageNumber == totalPages %}disabled{% endif %}">
                        <i class="fas fa-angle-right"></i>
                    </a>
                    
                    <a href="{{ path('app_user_management', {'page': totalPages, 'limit': itemsPerPage, 'role': selected_role, 'search': search}) }}" 
                       class="btn btn-sm btn-outline-primary {% if pagination.currentPageNumber == totalPages %}disabled{% endif %}">
                        <i class="fas fa-angle-double-right"></i>
                    </a>
                </div>
            </div>
        </main>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.31/jspdf.plugin.autotable.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Export PDF functionality
        document.getElementById('exportPdf').addEventListener('click', function() {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF();
            
            doc.text('User Management Report', 14, 15);
            doc.text('Generated on: ' + new Date().toLocaleDateString(), 14, 22);
            
            // Create table
            doc.autoTable({
                html: '#usersTable',
                startY: 30,
                theme: 'grid',
                headStyles: { fillColor: [41, 128, 185], textColor: 255 },
                columnStyles: {
                    0: { cellWidth: 20 }, // ID
                    1: { cellWidth: 60 }, // Email
                    2: { cellWidth: 30 }, // First Name
                    3: { cellWidth: 30 }, // Last Name
                    4: { cellWidth: 30 }, // Phone
                    5: { cellWidth: 30 }, // Role
                },
                columns: [
                    { header: 'ID', dataKey: 'id' },
                    { header: 'Email', dataKey: 'email' },
                    { header: 'First Name', dataKey: 'prenom' },
                    { header: 'Last Name', dataKey: 'nom' },
                    { header: 'Phone', dataKey: 'phone' },
                    { header: 'Role', dataKey: 'role' },
                ],
                didParseCell: function(data) {
                    // Remove the action buttons column
                    if (data.column.index === 6) {
                        return false;
                    }
                }
            });
            
            doc.save('user_management_report.pdf');
        });
        
        // Pagination page size buttons
        const pageSizeButtons = document.querySelectorAll('.page-size-btn');
        
        pageSizeButtons.forEach(button => {
            // Check if the current limit matches this button
            if (parseInt(button.dataset.size) === {{ itemsPerPage }}) {
                button.classList.add('active');
            } else {
                button.classList.remove('active');
            }
            
            button.addEventListener('click', function() {
                // Update active button
                pageSizeButtons.forEach(btn => btn.classList.remove('active'));
                this.classList.add('active');
                
                // Get the page size
                const pageSize = this.dataset.size;
                
                // Redirect to page 1 with the new limit and preserve filters
                window.location.href = '{{ path('app_user_management') }}?page=1&limit=' + pageSize + '&role={{ selected_role }}&search={{ search }}';
            });
        });
    });
</script>
{% endblock %}