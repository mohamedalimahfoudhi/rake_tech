{% extends 'base.html.twig' %}

{% block title %}Phone Verification{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h1 class="h3 mb-3 font-weight-normal text-center">Phone Verification</h1>
                </div>
                <div class="card-body">
                    {% for message in app.flashes('error') %}
                        <div class="alert alert-danger">
                            {{ message }}
                        </div>
                    {% endfor %}

                    <p class="text-center">We've sent a verification code to your phone number. Please enter it below to complete your registration.</p>

                    <form method="post">
                        <div class="form-group mb-3">
                            <label for="verification_code">Verification Code</label>
                            <input type="text" name="verification_code" id="verification_code" class="form-control" required autofocus>
                        </div>

                        <div class="d-grid gap-2">
                            <button class="btn btn-lg btn-primary" type="submit">
                                Verify
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %} 