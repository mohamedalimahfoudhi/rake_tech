{% extends 'base.html.twig' %}

{% block title %}Register{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h1 class="h3 mb-3 font-weight-normal text-center">Register</h1>
                </div>
                <div class="card-body">
                    {{ form_start(registrationForm) }}
                        <div class="row">
                            <div class="col-md-6">
                                {{ form_row(registrationForm.email) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(registrationForm.plainPassword) }}
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                {{ form_row(registrationForm.prenom) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(registrationForm.nom) }}
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                {{ form_row(registrationForm.genre) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(registrationForm.numeroTelephone) }}
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12">
                                {{ form_row(registrationForm.adresse) }}
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12">
                                {{ form_row(registrationForm.nomOrganisation) }}
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12">
                                {{ form_row(registrationForm.role) }}
                            </div>
                        </div>

                        <div class="d-grid gap-2 mt-3">
                            <button type="submit" class="btn btn-lg btn-primary">Register</button>
                        </div>
                    {{ form_end(registrationForm) }}
                </div>
                <div class="card-footer text-center">
                    <p class="mb-0">Already have an account? <a href="{{ path('app_login') }}">Login</a></p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %} 