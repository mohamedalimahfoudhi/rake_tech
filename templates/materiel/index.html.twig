{% extends 'base.html.twig' %}

{% block title %}List of Materiels - RackeTech{% endblock %}

{% block body %}
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <nav class="col-md-3 col-lg-2 d-md-block bg-light sidebar">
                <div class="position-sticky pt-3">
                    <!-- Logo and User Info -->
                    <div class="text-center mb-4">
                        <div class="logo mb-3">
                            <span class="logo-racket">🎾</span>
                            <span class="logo-text">RackeTech</span>
                        </div>
                        <div class="dropdown">
                            <a class="dropdown-toggle text-dark text-decoration-none" href="#" role="button" id="userDropdown" data-bs-toggle="dropdown">
                                <i class="fas fa-user-circle me-1"></i> {{ app.user.prenom }}
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="{{ path('app_profile') }}">Profile</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="{{ path('app_logout') }}">Logout</a></li>
                            </ul>
                        </div>
                    </div>

                    <!-- Navigation -->
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_dashboard') }}">
                                <i class="fas fa-tachometer-alt"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_user_management') }}">
                                <i class="fas fa-users"></i> User Management
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_emprunt_index') }}">
                                <i class="fas fa-users"></i> Emprunt Management
                            </a>
                        </li>
                             <li class="nav-item">
                            <a class="nav-link active" href="{{ path('app_materiel_index') }}">
                                <i class="fas fa-users"></i> Materiels Management
                            </a>
                        </li>
                         <li class="nav-item">
                            <a class="nav-link " href="{{ path('app_tournoi_index') }}">
                                <i class="fas fa-users"></i> Tournoi Management
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link  " href="{{ path('app_reservation_index') }}">
                                <i class="fas fa-users"></i> Reservation Management
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link  " href="{{ path('app_maintenance_index') }}">
                                <i class="fas fa-users"></i> Maintenance Management
                            </a>
                        </li>
                             <li class="nav-item">
							<a href="{{ path('app_event_index') }}" class="nav-link">
								<i class="fas fa-calendar"></i>
								Events
							</a>
						</li>
						<li class="nav-item">
							<a href="{{ path('app_terrain_index') }}" class="nav-link">
								<i class="fas fa-map"></i>
								Terrains
							</a>
						</li>
						{# <li class="nav-item">
							<a href="{{ path('app_mapb') }}" class="nav-link">
								<i class="fas fa-map"></i>
								Carte des terrains
							</a>
						</li> #}
						<li class="nav-item">
							<a href="{{ path('calb') }}" class="nav-link">
								<i class="fas fa-calendar"></i>
								Calendar Events
							</a>
						</li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <i class="fas fa-cog"></i> Settings
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <i class="fas fa-chart-bar"></i> Reports
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <i class="fas fa-bell"></i> Notifications
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>

            <!-- Main content -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2">Materiels Management</h1>
                    <div class="btn-toolbar mb-2 mb-md-0">
                        <div class="btn-group me-2">
                            <a href="{{ path('app_materiel_export_pdf') }}" class="btn btn-sm btn-outline-secondary">
                                <i class="fas fa-file-pdf"></i> Export PDF
                            </a>
                        </div>
                        <div class="btn-group me-2">
                            <a href="{{ path('app_materiel_new') }}" class="btn btn-primary">
                            <i class="fas fa-plus"></i> Nouvel Materiel
                            </a>                        
                        </div>
                    </div>
                </div>

                {% for message in app.flashes('success') %}
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {% endfor %}

                {% for message in app.flashes('error') %}
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {% endfor %}

                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Liste des Materiels</h5>
                    </div>
                    <div class="card-body">
                    
                    <!-- Status Counts -->
                    <div class="mb-3">
                        <a href="{{ path('app_materiel_index') }}" class="badge {% if not statusFilter %}bg-dark{% else %}bg-secondary{% endif %} text-decoration-none">
                            Tous <span class="badge bg-light text-dark">{{ totalCount }}</span>
                        </a>
                        <a href="{{ path('app_materiel_index', {status: 'Disponible'}) }}" class="badge {% if statusFilter == 'Disponible' %}bg-success{% else %}bg-secondary{% endif %} text-decoration-none">
                            Disponible <span class="badge bg-light text-dark">{{ disponibleCount }}</span>
                        </a>
                        <a href="{{ path('app_materiel_index', {status: 'Réservé'}) }}" class="badge {% if statusFilter == 'Réservé' %}bg-warning{% else %}bg-secondary{% endif %} text-decoration-none">
                            Réservé <span class="badge bg-light text-dark">{{ reserveCount }}</span>
                        </a>
                        <a href="{{ path('app_materiel_index', {status: 'Sous maintenance'}) }}" class="badge {% if statusFilter == 'Sous maintenance' %}bg-danger{% else %}bg-secondary{% endif %} text-decoration-none">
                            En maintenance <span class="badge bg-light text-dark">{{ maintenanceCount }}</span>
                        </a>
                    </div>
                    
                    <!-- Status Filter -->
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <form action="{{ path('app_materiel_index') }}" method="get" class="d-flex">
                                <select name="status" class="form-select me-2" onchange="this.form.submit()">
                                    <option value="">Tous les statuts</option>
                                    <option value="Disponible" {% if statusFilter == 'Disponible' %}selected{% endif %}>Disponible</option>
                                    <option value="Réservé" {% if statusFilter == 'Réservé' %}selected{% endif %}>Réservé</option>
                                    <option value="Sous maintenance" {% if statusFilter == 'Sous maintenance' %}selected{% endif %}>Sous maintenance</option>
                                </select>
                                {% if statusFilter %}
                                    <a href="{{ path('app_materiel_index') }}" class="btn btn-outline-secondary">
                                        <i class="fas fa-times"></i> Réinitialiser
                                    </a>
                                {% endif %}
                            </form>
                        </div>
                        {% if statusFilter %}
                        <div class="col-md-8">
                            <div class="alert alert-info py-2 mb-0">
                                <i class="fas fa-filter"></i> 
                                Filtrage par statut: <strong>
                                {% if statusFilter == 'Disponible' %}
                                    <span class="text-success">Disponible</span>
                                {% elseif statusFilter == 'Réservé' %}
                                    <span class="text-warning">Réservé</span>
                                {% elseif statusFilter == 'Sous maintenance' %}
                                    <span class="text-danger">En maintenance</span>
                                {% endif %}
                                </strong>
                            </div>
                        </div>
                        {% endif %}
                    </div>
                    
                    <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Type</th>
                                <th>Sport</th>
                                <th>Prix</th>
                                <th>Date de réservation</th>
                                <th>Statut</th>
                                <th>Propriétaire</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for materiel in pager.getIterator() %}
                                <tr>
                                    <td>{{ materiel.type }}</td>
                                    <td>{{ materiel.typesport }}</td>
                                    <td>{{ materiel.prix|number_format(2, ',', ' ') }} €</td>
                                    <td>{{ materiel.datereservation ? materiel.datereservation|date('d/m/Y H:i') : 'Non définie' }}</td>
                                    <td>
                                        {% if materiel.statut == 'Disponible' %}
                                            <span class="badge bg-success">Disponible</span>
                                        {% elseif materiel.statut == 'Réservé' %}
                                            <span class="badge bg-warning">Réservé</span>
                                        {% else %}
                                            <span class="badge bg-danger">En maintenance</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if materiel.ownertype == 'Club' %}
                                            <span class="badge bg-primary">Club</span>
                                        {% else %}
                                            <span class="badge bg-secondary">Autre</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <div class="btn-group">
                                            <a href="{{ path('app_materiel_show', {'id': materiel.id}) }}" class="btn btn-sm btn-info">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a href="{{ path('app_materiel_edit', {'id': materiel.id}) }}" class="btn btn-sm btn-warning">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <form method="post" action="{{ path('app_materiel_delete', {'id': materiel.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce materiel ?');" style="display: inline;">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ materiel.id) }}">
                                                <button class="btn btn-danger btn-sm">
                                                    <i class="ri-delete-bin-line"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="7" class="text-center">Aucun matériel trouvé</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                {# Pagination controls #}
                <div class="pagination">
                    <span>Page {{ pager.getCurrentPage() }} sur {{ pager.getNbPages() }}</span>
                    <div class="pagination-controls">
                        {% if pager.hasPreviousPage() %}
                            <a href="{{ path('app_materiel_index', { page: pager.getPreviousPage(), status: statusFilter }) }}" class="btn btn-sm btn-outline-secondary">Précédent</a>
                        {% endif %}
                        {% if pager.hasNextPage() %}
                            <a href="{{ path('app_materiel_index', { page: pager.getNextPage(), status: statusFilter }) }}" class="btn btn-sm btn-outline-secondary">Suivant</a>
                        {% endif %}
                    </div>
                </div>

            </main>
        </div>
    </div>
{% endblock %}
