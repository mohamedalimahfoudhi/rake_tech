{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="jumbotron bg-light p-5 rounded">
                <h1 class="display-4">Welcome, {{ app.user.prenom|default('User') }}</h1>
                <p class="lead">Discover, book, and manage tickets for the best events.</p>
                <hr class="my-4">
                <p>Browse our upcoming events or manage your tickets.</p>
                <a class="btn btn-primary btn-lg" href="#" role="button">Browse Events</a>
                
                {% if is_granted('ROLE_ADMIN') %}
                    <a class="btn btn-success btn-lg ms-2" href="{{ path('admin_dashboard') }}" role="button">Admin Dashboard</a>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-12">
            <h2 class="mb-4">Featured Events</h2>
        </div>
        
        {% if upcoming_events is defined and upcoming_events|length > 0 %}
            {% for event in upcoming_events %}
                <div class="col-md-4 mb-4">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">{{ event.nom }}</h5>
                            <h6 class="card-subtitle mb-2 text-muted">
                                {% if event.dateDebut %}
                                    {{ event.dateDebut|date('Y-m-d') }}
                                {% else %}
                                    Date TBD
                                {% endif %}
                            </h6>
                            <p class="card-text">{{ event.details|length > 100 ? event.details|slice(0, 100) ~ '...' : event.details }}</p>
                            <a href="#" class="btn btn-primary">View Details</a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        {% else %}
            <div class="col-12">
                <div class="alert alert-info">
                    No upcoming events at this time. Check back soon!
                </div>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %} 