<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Ticket Refund Confirmation</title>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            line-height: 1.6;
            color: #333;
            max-width: 600px;
            margin: 0 auto;
        }
        .header {
            background-color: #2ecc71;
            padding: 20px;
            text-align: center;
            color: white;
            border-radius: 5px 5px 0 0;
        }
        .logo {
            font-size: 24px;
            font-weight: bold;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .logo-icon {
            font-size: 28px;
            margin-right: 10px;
        }
        .content {
            padding: 20px;
            background-color: #f9f9f9;
            border: 1px solid #ddd;
            border-top: none;
            border-radius: 0 0 5px 5px;
        }
        .footer {
            text-align: center;
            margin-top: 20px;
            font-size: 12px;
            color: #888;
        }
        .detail-row {
            display: flex;
            margin-bottom: 10px;
        }
        .detail-label {
            width: 120px;
            font-weight: bold;
        }
        .ticket-info {
            background-color: #fff;
            border: 1px solid #eee;
            padding: 15px;
            margin: 15px 0;
            border-radius: 5px;
        }
        .refund-message {
            background-color: #e8f5e9;
            border-left: 4px solid #2ecc71;
            padding: 10px 15px;
            margin: 15px 0;
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="logo">
            <span class="logo-icon">🎾</span>
            <span>RackeTech</span>
        </div>
    </div>
    
    <div class="content">
        <h2>Ticket Refund Confirmation</h2>
        
        <p>Dear {{ user.prenom }} {{ user.nom }},</p>
        
        <div class="refund-message">
            <p>Your ticket refund request has been processed successfully. {% if deleted %}The ticket has been completely removed from your account.{% else %}Your payment will be refunded according to your original payment method's terms.{% endif %}</p>
        </div>
        
        <div class="ticket-info">
            <h3>Refunded Ticket Details</h3>
            
            <div class="detail-row">
                <div class="detail-label">Event:</div>
                <div>{{ event.nom }}</div>
            </div>
            
            <div class="detail-row">
                <div class="detail-label">Date:</div>
                <div>{{ event.dateDebut|date('F d, Y') }} at {{ event.dateDebut|date('g:i A') }}</div>
            </div>
            
            <div class="detail-row">
                <div class="detail-label">Location:</div>
                <div>{{ event.type }}</div>
            </div>
            
            <div class="detail-row">
                <div class="detail-label">Ticket Type:</div>
                <div>{{ ticket.typeBillet }}</div>
            </div>
            
            <div class="detail-row">
                <div class="detail-label">Refund Date:</div>
                <div>{{ "now"|date('F d, Y') }}</div>
            </div>
            
            <div class="detail-row">
                <div class="detail-label">Reference #:</div>
                <div>RF-{{ reservation.id }}</div>
            </div>
            
            <div class="detail-row">
                <div class="detail-label">Status:</div>
                <div>{% if deleted %}<strong style="color: #e74c3c;">Deleted</strong>{% else %}<strong style="color: #2ecc71;">Refunded</strong>{% endif %}</div>
            </div>
        </div>
        
        <p>If you have any questions about your refund, please contact our support team.</p>
        
        <p>Thank you for using RackeTech!</p>
    </div>
    
    <div class="footer">
        <p>© {{ "now"|date('Y') }} RackeTech. All rights reserved.</p>
        <p>This is an automated email, please do not reply.</p>
    </div>
</body>
</html> 