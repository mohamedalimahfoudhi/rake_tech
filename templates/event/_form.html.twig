{{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

    <div>
        {{ form_label(form.details) }}
        {{ form_widget(form.details) }}
        {% if form.details.vars.errors|length > 0 %}
            <ul class="error-list">
                {% for error in form.details.vars.errors %}
                    <li class="error">{{ error.message }}</li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>

