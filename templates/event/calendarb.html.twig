{% extends 'base.html.twig' %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <!-- Sidebar -->
        <nav class="col-md-3 col-lg-2 d-md-block bg-light sidebar">
            <div class="position-sticky pt-3">
                <!-- Logo and User Info -->
                <div class="text-center mb-4">
                    <div class="logo mb-3">
                        <span class="logo-racket">🎾</span>
                        <span class="logo-text">RackeTech</span>
                    </div>
                    <!-- Custom Dropdown Implementation -->
                    <div class="user-dropdown">
                        <div onclick="toggleUserDropdown()" class="btn btn-sm btn-light" id="userDropdownBtn">
                            <i class="fas fa-user-circle me-1"></i> {{ app.user.prenom }} <i
                                class="fas fa-caret-down"></i>
                        </div>
                        <div id="userDropdownContent" class="user-dropdown-content">
                            <a href="{{ path('app_profile') }}">Profile</a>
                            <div class="user-dropdown-divider"></div>
                            <a href="{{ path('app_logout') }}">Logout</a>
                        </div>
                    </div>
                </div>

                <!-- Navigation -->
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link " href="{{ path('app_dashboard') }}">
                            <i class="fas fa-tachometer-alt"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_user_management') }}">
                            <i class="fas fa-users"></i> User Management
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_emprunt_index') }}">
                            <i class="fas fa-handshake"></i> Emprunt Management
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_materiel_index') }}">
                            <i class="fas fa-toolbox"></i> Materiels Management
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_tournoi_index') }}">
                            <i class="fas fa-trophy"></i> Tournoi Management
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_reservation_index') }}">
                            <i class="fas fa-calendar-check"></i> Reservation Management
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link  " href="{{ path('app_maintenance_index') }}">
                            <i class="fas fa-users"></i> Maintenance Management
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_event_index') }}" class="nav-link">
                            <i class="fas fa-calendar"></i>
                            Events
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_terrain_index') }}" class="nav-link">
                            <i class="fas fa-map"></i>
                            Terrains
                        </a>
                    </li>
                    {# <li class="nav-item">
                        <a href="{{ path('app_mapb') }}" class="nav-link">
                            <i class="fas fa-map"></i>
                            Carte des terrains
                        </a>
                    </li> #}
                    <li class="nav-item ">
                        <a href="{{ path('calb') }}" class="nav-link active">
                            <i class="fas fa-calendar"></i>
                            Calendar Events
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            <i class="fas fa-cog"></i> Settings
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            <i class="fas fa-chart-bar"></i> Reports
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            <i class="fas fa-bell"></i> Notifications
                        </a>
                    </li>
                </ul>
            </div>
        </nav>

        <!-- Main content -->
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div id="calendar">
            </div>
        </main>
    </div>
</div>
<!-- FullCalendar CSS -->
<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.css" rel="stylesheet">

<!-- FullCalendar JS (version "global") -->
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js"></script>

<style>
    #calendar {
        max-width: 900px;
        margin: 40px auto;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const calendarEl = document.getElementById('calendar');
        const calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            events: '/event/api/events',
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek'
            }
        });
        calendar.render();
    });
</script>
{% endblock %}