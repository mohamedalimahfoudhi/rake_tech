<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
        
        {% block stylesheets %}
            <!-- Bootstrap CSS -->
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
            <!-- Font Awesome -->
            <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
            
            <!-- Global Tennis Theme Override -->
            <style>
                :root {
                    --tennis-green: #2ecc71;
                    --tennis-light-green: #a8e6cf;
                    --tennis-yellow: #f1c40f;
                    --tennis-light-yellow: #ffd93d;
                    --bs-primary: #2ecc71 !important;
                    --bs-primary-rgb: 46, 204, 113 !important;
                    --bs-link-color: #27ae60 !important;
                    --bs-link-hover-color: #2ecc71 !important;
                    --bs-info: #3dd4af !important;
                    --bs-info-rgb: 61, 212, 175 !important;
                }
                
                /* Override Bootstrap blue components */
                .btn-primary {
                    background-color: var(--tennis-green) !important;
                    border-color: var(--tennis-green) !important;
                }
                
                .btn-primary:hover, .btn-primary:focus, .btn-primary:active {
                    background-color: #27ae60 !important;
                    border-color: #27ae60 !important;
                }
                
                .btn-outline-primary {
                    color: var(--tennis-green) !important;
                    border-color: var(--tennis-green) !important;
                }
                
                .btn-outline-primary:hover, .btn-outline-primary:focus, .btn-outline-primary:active {
                    background-color: var(--tennis-green) !important;
                    color: white !important;
                }
                
                .bg-primary {
                    background-color: var(--tennis-green) !important;
                }
                
                .text-primary {
                    color: var(--tennis-green) !important;
                }
                
                .border-primary {
                    border-color: var(--tennis-green) !important;
                }
                
                .badge.bg-primary {
                    background-color: var(--tennis-green) !important;
                }
                
                .btn-info, .bg-info {
                    background-color: #3dd4af !important;
                    border-color: #3dd4af !important;
                }
                
                .btn-outline-info {
                    color: #3dd4af !important;
                    border-color: #3dd4af !important;
                }
                
                .btn-outline-info:hover, .btn-outline-info:focus, .btn-outline-info:active {
                    background-color: #3dd4af !important;
                    color: white !important;
                }
                
                .alert-info {
                    background-color: rgba(61, 212, 175, 0.2) !important;
                    border-color: rgba(61, 212, 175, 0.5) !important;
                    color: #2a7d67 !important;
                }
                
                /* Links */
                a {
                    color: #27ae60;
                }
                
                a:hover {
                    color: #2ecc71;
                }
            </style>
            
            {% if not app.request.get('_route') starts with 'admin_' and app.request.get('_route') != 'app_login' %}
            <style>
                body {
                    min-height: 100vh;
                    background: linear-gradient(-45deg, var(--tennis-green), var(--tennis-light-green), var(--tennis-yellow), var(--tennis-light-yellow));
                    background-size: 400% 400%;
                    animation: gradient 15s ease infinite;
                }

                @keyframes gradient {
                    0% { background-position: 0% 50%; }
                    50% { background-position: 100% 50%; }
                    100% { background-position: 0% 50%; }
                }

                .navbar {
                    background: rgba(46, 204, 113, 0.15) !important;
                    backdrop-filter: blur(12px);
                    -webkit-backdrop-filter: blur(12px);
                    border-bottom: 1px solid rgba(46, 204, 113, 0.3);
                }

                .navbar-brand, .nav-link {
                    color: white !important;
                    font-weight: 500;
                    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
                }

                .nav-link:hover {
                    color: var(--tennis-yellow) !important;
                    text-shadow: 0 0 10px rgba(241, 196, 15, 0.5);
                }

                .navbar-toggler {
                    border-color: rgba(46, 204, 113, 0.5);
                }

                .navbar-toggler-icon {
                    background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba(46, 204, 113, 0.8)' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
                }

                .btn-glass {
                    background: rgba(46, 204, 113, 0.15);
                    border: 1px solid rgba(46, 204, 113, 0.3);
                    color: white;
                    font-weight: 500;
                    padding: 0.5rem 1rem;
                    transition: all 0.3s ease;
                }

                .btn-glass:hover {
                    background: rgba(46, 204, 113, 0.25);
                    border-color: rgba(46, 204, 113, 0.4);
                    transform: translateY(-2px);
                    color: white;
                    box-shadow: 0 5px 15px rgba(46, 204, 113, 0.2);
                }

                .btn-glass.danger {
                    background: rgba(241, 196, 15, 0.15);
                    border-color: rgba(241, 196, 15, 0.3);
                }

                .btn-glass.danger:hover {
                    background: rgba(241, 196, 15, 0.25);
                    border-color: rgba(241, 196, 15, 0.4);
                    box-shadow: 0 5px 15px rgba(241, 196, 15, 0.2);
                }

                .btn-glass.success {
                    background: rgba(46, 204, 113, 0.15);
                    border-color: rgba(46, 204, 113, 0.3);
                }

                .btn-glass.success:hover {
                    background: rgba(46, 204, 113, 0.25);
                    border-color: rgba(46, 204, 113, 0.4);
                    box-shadow: 0 5px 15px rgba(46, 204, 113, 0.2);
                }

                .card {
                    background: rgba(46, 204, 113, 0.15);
                    backdrop-filter: blur(12px);
                    -webkit-backdrop-filter: blur(12px);
                    border: 1px solid rgba(46, 204, 113, 0.3);
                    border-radius: 1rem;
                    box-shadow: 0 8px 32px rgba(46, 204, 113, 0.1);
                }

                .card-header {
                    background: rgba(46, 204, 113, 0.1);
                    border-bottom: 1px solid rgba(46, 204, 113, 0.2);
                    color: white;
                }

                .card-body {
                    color: white;
                }

                .table {
                    color: white;
                }

                .table thead th {
                    border-color: rgba(46, 204, 113, 0.2);
                    background: rgba(46, 204, 113, 0.1);
                }

                .table td {
                    border-color: rgba(46, 204, 113, 0.1);
                }

                .table tbody tr:hover {
                    background: rgba(46, 204, 113, 0.1);
                }

                /* Tennis ball glow effect for important elements */
                .tennis-glow {
                    position: relative;
                }

                .tennis-glow::after {
                    content: '';
                    position: absolute;
                    top: -2px;
                    left: -2px;
                    right: -2px;
                    bottom: -2px;
                    background: linear-gradient(45deg, var(--tennis-green), var(--tennis-yellow));
                    border-radius: inherit;
                    z-index: -1;
                    opacity: 0;
                    transition: opacity 0.3s ease;
                }

                .tennis-glow:hover::after {
                    opacity: 0.6;
                }

                /* Custom scrollbar */
                ::-webkit-scrollbar {
                    width: 10px;
                }

                ::-webkit-scrollbar-track {
                    background: rgba(46, 204, 113, 0.1);
                }

                ::-webkit-scrollbar-thumb {
                    background: linear-gradient(var(--tennis-green), var(--tennis-yellow));
                    border-radius: 5px;
                }

                ::-webkit-scrollbar-thumb:hover {
                    background: linear-gradient(var(--tennis-yellow), var(--tennis-green));
                }
                
                /* Logo CSS */
                .logo {
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 1.5rem;
                    font-weight: bold;
                    color: #333;
                }

                .logo-racket {
                    font-size: 1.8rem;
                    margin-right: 5px;
                }

                .logo-text {
                    background: linear-gradient(45deg, #2ecc71, #27ae60);
                    -webkit-background-clip: text;
                    background-clip: text;
                    -webkit-text-fill-color: transparent;
                    font-weight: 700;
                }
                
                /* Navbar logo adjustments */
                .navbar-brand.logo {
                    color: inherit !important;
                }
                
                .navbar-brand .logo-text {
                    text-shadow: none;
                }
            </style>
            {% endif %}
        {% endblock %}

        {% block javascripts %}
            <!-- Bootstrap Bundle with Popper -->
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
            {% block importmap %}
                {% if app.request.get('_route') == 'app_login' %}
                    {{ importmap('auth') }}
                {% elseif app.request.get('_route') starts with 'admin_' %}
                    {{ importmap('admin') }}
                {% else %}
                    {{ importmap('app') }}
                {% endif %}
            {% endblock %}
        {% endblock %}
    </head>
    <body>
        {% if app.user and app.request.get('_route') != 'app_login' and not app.request.get('_route') starts with 'admin_' %}
            <nav class="navbar navbar-expand-lg">
                <div class="container">
                    <a class="navbar-brand tennis-glow" href="{{ path('app_dashboard') }}">
                        <div class="logo">
                            <span class="logo-racket">🎾</span>
                            <span class="logo-text">RackeTech</span>
                        </div>
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navbarNav">
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item">
                                <a class="nav-link tennis-glow" href="{{ path('app_dashboard') }}">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link tennis-glow" href="#">Events</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link tennis-glow" href="{{ path('exchange_rates') }}">
                                    <i class="fas fa-dollar-sign"></i> Exchange Rates
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link tennis-glow" href="{{ path('cart_index') }}">
                                    <i class="fas fa-calculator"></i> Price Calculator
                                    <span class="badge bg-warning text-dark">{{ app.session.get('cart')|length|default(0) }}</span>
                                </a>
                            </li>
                        </ul>
                        <div class="d-flex">
                            {% if is_granted('ROLE_ADMIN') %}
                                <a href="{{ path('admin_dashboard') }}" class="btn btn-glass success tennis-glow me-2">Admin</a>
                            {% endif %}
                            <a href="{{ path('app_logout') }}" class="btn btn-glass danger tennis-glow">Logout</a>
                        </div>
                    </div>
                </div>
            </nav>
        {% endif %}
        
        {% if not app.request.get('_route') starts with 'admin_' %}
        <div class="container py-4">
        {% endif %}
            {% block body %}{% endblock %}
        {% if not app.request.get('_route') starts with 'admin_' %}
        </div>
        {% endif %}
    </body>
</html>
