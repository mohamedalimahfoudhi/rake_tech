<form method="post" action="{{ path('app_maintenance_delete', {'id': maintenance.maintenanceid}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette maintenance ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ maintenance.maintenanceid) }}">
    <button class="btn btn-sm btn-danger" title="Supprimer">
        <i class="fas fa-trash"></i>
    </button>
</form> 