{% extends 'base.html.twig' %}

{% block title %}Liste des Maintenances{% endblock %}

{% block body %}
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <nav class="col-md-3 col-lg-2 d-md-block bg-light sidebar">
                <div class="position-sticky pt-3">
                    <!-- Logo and User Info -->
                    <div class="text-center mb-4">
                        <div class="logo mb-3">
                            <span class="logo-racket">🎾</span>
                            <span class="logo-text">RackeTech</span>
                        </div>
                        <div class="dropdown">
                            <a class="dropdown-toggle text-dark text-decoration-none" href="#" role="button" id="userDropdown" data-bs-toggle="dropdown">
                                <i class="fas fa-user-circle me-1"></i> {{ app.user.prenom }}
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="{{ path('app_profile') }}">Profile</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="{{ path('app_logout') }}">Logout</a></li>
                            </ul>
                        </div>
                    </div>

                    <!-- Navigation -->
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_dashboard') }}">
                                <i class="fas fa-tachometer-alt"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_user_management') }}">
                                <i class="fas fa-users"></i> User Management
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link " href="{{ path('app_emprunt_index') }}">
                                <i class="fas fa-users"></i> Emprunt Management
                            </a>
                        </li>
                            <li class="nav-item">
                            <a class="nav-link " href="{{ path('app_materiel_index') }}">
                                <i class="fas fa-users"></i> Materiels Management
                            </a>
                        </li>
                        </li>
                             <li class="nav-item">
                            <a class="nav-link  " href="{{ path('app_tournoi_index') }}">
                                <i class="fas fa-users"></i> Tournoi Management
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link  " href="{{ path('app_reservation_index') }}">
                                <i class="fas fa-users"></i> Reservation Management
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link active " href="{{ path('app_maintenance_index') }}">
                                <i class="fas fa-users"></i> Maintenance Management
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <i class="fas fa-cog"></i> Settings
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <i class="fas fa-chart-bar"></i> Reports
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <i class="fas fa-bell"></i> Notifications
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>

            <!-- Main content -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2">Maintenance Management</h1>
                    <div class="btn-toolbar mb-2 mb-md-0">
                        <div class="btn-group me-2">
                            <a href="{{ path('app_maintenance_export_pdf') }}" class="btn btn-sm btn-outline-secondary">
                                <i class="fas fa-file-pdf"></i> Export PDF
                            </a>
                        </div>
                        <div class="btn-group me-2">
                            <a href="{{ path('app_emprunt_new') }}" class="btn btn-primary">
                            <i class="fas fa-plus"></i> Nouvel Maintenance
                            </a>                        
                        </div>



                    </div>
                </div>

                {% for message in app.flashes('success') %}
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {% endfor %}

                {% for message in app.flashes('error') %}
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {% endfor %}
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Description</th>
                                <th>Statut</th>
                                <th>Matériel</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for maintenance in maintenances %}
                                <tr>
                                    <td>{{ maintenance.datemaintenance ? maintenance.datemaintenance|date('d/m/Y') : '' }}</td>
                                    <td>{{ maintenance.description|slice(0, 50) }}{% if maintenance.description|length > 50 %}...{% endif %}</td>
                                    <td>
                                        {% if maintenance.statutmaintenance == 'Planifié' %}
                                            <span class="badge bg-warning">Planifié</span>
                                        {% elseif maintenance.statutmaintenance == 'En cours' %}
                                            <span class="badge bg-info">En cours</span>
                                        {% elseif maintenance.statutmaintenance == 'Terminé' %}
                                            <span class="badge bg-success">Terminé</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if maintenance.materielid %}
                                            <div class="d-flex align-items-center">
                                                <i class="fas fa-tools me-2"></i>
                                                <div>
                                                    <strong>{{ maintenance.materielid.type }}</strong>
                                                    <div class="text-muted small">
                                                        {{ maintenance.materielid.typesport }}
                                                    </div>
                                                </div>
                                            </div>
                                        {% else %}
                                            <span class="text-muted">-</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a href="{{ path('app_maintenance_show', {'id': maintenance.maintenanceid}) }}" 
                                               class="btn btn-sm btn-outline-primary" 
                                               title="Voir les détails">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a href="{{ path('app_maintenance_edit', {'id': maintenance.maintenanceid}) }}" 
                                               class="btn btn-sm btn-outline-secondary" 
                                               title="Modifier">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="5" class="text-center">Aucune maintenance trouvée</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

