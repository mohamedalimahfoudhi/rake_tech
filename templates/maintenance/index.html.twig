{% extends 'base.html.twig' %}

{% block title %}Liste des Maintenances{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3 mb-0">Liste des Maintenances</h1>
            <a href="{{ path('app_maintenance_new') }}" class="btn btn-primary">
                <i class="fas fa-plus"></i> Nouvelle Maintenance
            </a>
        </div>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}

        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Description</th>
                                <th>Statut</th>
                                <th>Matériel</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for maintenance in maintenances %}
                                <tr>
                                    <td>{{ maintenance.datemaintenance ? maintenance.datemaintenance|date('d/m/Y') : '' }}</td>
                                    <td>{{ maintenance.description|slice(0, 50) }}{% if maintenance.description|length > 50 %}...{% endif %}</td>
                                    <td>
                                        {% if maintenance.statutmaintenance == 'Planifié' %}
                                            <span class="badge bg-warning">Planifié</span>
                                        {% elseif maintenance.statutmaintenance == 'En cours' %}
                                            <span class="badge bg-info">En cours</span>
                                        {% elseif maintenance.statutmaintenance == 'Terminé' %}
                                            <span class="badge bg-success">Terminé</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if maintenance.materielid %}
                                            <div class="d-flex align-items-center">
                                                <i class="fas fa-tools me-2"></i>
                                                <div>
                                                    <strong>{{ maintenance.materielid.type }}</strong>
                                                    <div class="text-muted small">
                                                        {{ maintenance.materielid.typesport }}
                                                    </div>
                                                </div>
                                            </div>
                                        {% else %}
                                            <span class="text-muted">-</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a href="{{ path('app_maintenance_show', {'id': maintenance.maintenanceid}) }}" 
                                               class="btn btn-sm btn-outline-primary" 
                                               title="Voir les détails">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a href="{{ path('app_maintenance_edit', {'id': maintenance.maintenanceid}) }}" 
                                               class="btn btn-sm btn-outline-secondary" 
                                               title="Modifier">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="5" class="text-center">Aucune maintenance trouvée</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

