<form method="post" action="{{ path('app_emprunt_delete', {'id': emprunt.empruntid}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet emprunt?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ emprunt.empruntid) }}">
    <button class="btn">Supprimer</button>
</form>
