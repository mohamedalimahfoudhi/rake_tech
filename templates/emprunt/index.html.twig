{% extends 'base.html.twig' %}

{% block title %}Liste des Emprunts - RackeTech{% endblock %}

{% block body %}
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <nav class="col-md-3 col-lg-2 d-md-block bg-light sidebar">
                <div class="position-sticky pt-3">
                    <!-- Logo and User Info -->
                    <div class="text-center mb-4">
                        <div class="logo mb-3">
                            <span class="logo-racket">🎾</span>
                            <span class="logo-text">RackeTech</span>
                        </div>
                        <div class="dropdown">
                            <a class="dropdown-toggle text-dark text-decoration-none" href="#" role="button" id="userDropdown" data-bs-toggle="dropdown">
                                <i class="fas fa-user-circle me-1"></i> {{ app.user.prenom }}
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="{{ path('app_profile') }}">Profile</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="{{ path('app_logout') }}">Logout</a></li>
                            </ul>
                        </div>
                    </div>

                    <!-- Navigation -->
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_dashboard') }}">
                                <i class="fas fa-tachometer-alt"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_user_management') }}">
                                <i class="fas fa-users"></i> User Management
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link active" href="{{ path('app_emprunt_index') }}">
                                <i class="fas fa-users"></i> Emprunt Management
                            </a>
                        </li>
                            <li class="nav-item">
                            <a class="nav-link " href="{{ path('app_materiel_index') }}">
                                <i class="fas fa-users"></i> Materiels Management
                            </a>
                        </li>
                        </li>
                             <li class="nav-item">
                            <a class="nav-link  " href="{{ path('app_tournoi_index') }}">
                                <i class="fas fa-users"></i> Tournoi Management
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link  " href="{{ path('app_reservation_index') }}">
                                <i class="fas fa-users"></i> Reservation Management
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <i class="fas fa-cog"></i> Settings
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <i class="fas fa-chart-bar"></i> Reports
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <i class="fas fa-bell"></i> Notifications
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>

            <!-- Main content -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2">Emprunts Management</h1>
                    <div class="btn-toolbar mb-2 mb-md-0">
                        <div class="btn-group me-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary">Export</button>
                        </div>
                        <div class="btn-group me-2">
                            <a href="{{ path('app_emprunt_new') }}" class="btn btn-primary">
                            <i class="fas fa-plus"></i> Nouvel Emprunt
                            </a>                        
                        </div>



                    </div>
                </div>

                {% for message in app.flashes('success') %}
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {% endfor %}

                {% for message in app.flashes('error') %}
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {% endfor %}


                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Emprunts</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                <th>Matériel</th>
                                <th>Utilisateur</th>
                                <th>Date d'emprunt</th>
                                <th>Date de retour</th>
                                <th>Statut</th>
                                <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for emprunt in emprunts %}
                                        <tr>
                                <td>{{ emprunt.materielId.type }}</td>
                                <td>{{ emprunt.userId.nom }} {{ emprunt.userId.prenom }}</td>
                                <td>{{ emprunt.dateEmprunt|date('d/m/Y') }}</td>
                                <td>{{ emprunt.dateRetour|date('d/m/Y') }}</td>
                                <td>
                                    {% if emprunt.statutEmprunt == 'Emprunté' %}
                                        <span class="badge bg-primary">{{ emprunt.statutEmprunt }}</span>
                                    {% elseif emprunt.statutEmprunt == 'Retourné' %}
                                        <span class="badge bg-success">{{ emprunt.statutEmprunt }}</span>
                                    {% else %}
                                        <span class="badge bg-danger">{{ emprunt.statutEmprunt }}</span>
                                    {% endif %}
                                </td>
                                            <td>
                                    <div class="btn-group">
                                        <a href="{{ path('app_emprunt_show', {'id': emprunt.empruntid}) }}" class="btn btn-sm btn-info" title="Voir">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="{{ path('app_emprunt_edit', {'id': emprunt.empruntid}) }}" class="btn btn-sm btn-warning" title="Modifier">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        {{ include('emprunt/_delete_form.html.twig') }}
                                    </div>
                                            </td>
                                        </tr>
                        {% else %}
                            <tr>
                                <td colspan="7" class="text-center">Aucun emprunt trouvé</td>
                            </tr>
                        {% endfor %}                                
                        </tbody>
                        </table>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>


    
{% endblock %} 