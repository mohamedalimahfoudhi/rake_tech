{% extends 'base.html.twig' %}

{% block title %}Terrain{% endblock %}

{% block body %}
    <h1>Terrain</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ terrain.id }}</td>
            </tr>
            <tr>
                <th>CourtType</th>
                <td>{{ terrain.courtType }}</td>
            </tr>
            <tr>
                <th>Location</th>
                <td>{{ terrain.location }}</td>
            </tr>
            <tr>
