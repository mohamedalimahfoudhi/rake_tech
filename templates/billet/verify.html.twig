{% extends 'base.html.twig' %}

{% block title %}Vérification de Billet - RackeTech{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .verification-container {
        max-width: 600px;
        margin: 50px auto;
        text-align: center;
        padding: 30px;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }
    .verification-icon {
        font-size: 5rem;
        margin-bottom: 20px;
    }
    .verification-valid {
        color: #28a745;
    }
    .verification-invalid {
        color: #dc3545;
    }
    .ticket-details {
        margin-top: 30px;
        text-align: left;
    }
</style>
{% endblock %}

{% block body %}
<div class="container">
    <div class="verification-container {% if isValid %}bg-light{% else %}bg-light{% endif %}">
        {% if isValid %}
            <div class="verification-icon verification-valid">
                <i class="fas fa-check-circle"></i>
            </div>
            <h2>Billet Valide</h2>
            <p class="lead">Ce billet est valide et peut être utilisé.</p>
        {% else %}
            <div class="verification-icon verification-invalid">
                <i class="fas fa-times-circle"></i>
            </div>
            <h2>Billet Non Valide</h2>
            <p class="lead">Ce billet n'est pas valide ou a déjà été utilisé.</p>
        {% endif %}
        
        <div class="ticket-details">
            <h4>Détails du billet</h4>
            <table class="table">
                <tr>
                    <th>ID</th>
                    <td>{{ billet.id }}</td>
                </tr>
                <tr>
                    <th>Type</th>
                    <td>{{ billet.typeBillet }}</td>
                </tr>
                <tr>
                    <th>Événement</th>
                    <td>{{ billet.eventId ? billet.eventId.name : 'N/A' }}</td>
                </tr>
                <tr>
                    <th>Date de l'événement</th>
                    <td>
                        {% if billet.eventId %}
                            {{ billet.eventId.startDate|date('d/m/Y H:i') }}
                        {% else %}
                            N/A
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th>Statut</th>
                    <td>
                        <span class="badge {% if billet.statut == 'Valide' %}bg-success{% elseif billet.statut == 'Non valide' %}bg-warning{% else %}bg-danger{% endif %}">
                            {{ billet.statut }}
                        </span>
                    </td>
                </tr>
                <tr>
                    <th>Date d'achat</th>
                    <td>{{ billet.dateAchat ? billet.dateAchat|date('d/m/Y H:i') : 'N/A' }}</td>
                </tr>
            </table>
        </div>
        
        <div class="mt-4">
            <p class="text-muted">Vérifié le {{ "now"|date('d/m/Y H:i') }}</p>
            {% if isValid and is_granted('ROLE_ADMIN') %}
                <form method="post" action="{{ path('app_ticket_mark_used', {'id': billet.id}) }}" class="mt-3">
                    <input type="hidden" name="_token" value="{{ csrf_token('mark_used' ~ billet.id) }}">
                    <button type="submit" class="btn btn-warning">
                        <i class="fas fa-check-double"></i> Marquer comme utilisé
                    </button>
                </form>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %} 