{% extends 'base.html.twig' %}

{% block title %}Ticket Verification - RackeTech{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .verification-container {
        max-width: 600px;
        margin: 0 auto;
    }
    
    .verification-card {
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }
    
    .verification-header {
        padding: 20px;
        text-align: center;
    }
    
    .verification-valid {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: white;
    }
    
    .verification-invalid {
        background: linear-gradient(135deg, #dc3545 0%, #f86c6b 100%);
        color: white;
    }
    
    .verification-body {
        padding: 30px;
        text-align: center;
    }
    
    .verification-icon {
        font-size: 5rem;
        margin-bottom: 20px;
    }
    
    .ticket-info {
        margin-top: 30px;
        text-align: left;
        padding: 20px;
        background-color: #f8f9fa;
        border-radius: 10px;
    }
</style>
{% endblock %}

{% block body %}
<div class="container mt-4 mb-5">
    <div class="row mb-4">
        <div class="col-md-6">
            <h1>Ticket Verification</h1>
        </div>
        <div class="col-md-6 text-end">
            <a href="{{ path('app_athlete_tickets') }}" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to My Tickets
            </a>
        </div>
    </div>
    
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('warning') %}
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}
    
    <div class="verification-container">
        <div class="verification-card">
            <div class="verification-header {% if isValid %}verification-valid{% else %}verification-invalid{% endif %}">
                <h2 class="mb-0">Ticket Status</h2>
            </div>
            
            <div class="verification-body">
                {% if isValid %}
                    <div class="verification-icon text-success">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <h3>Valid Ticket</h3>
                    <p class="lead">This ticket is valid and can be used for entry.</p>
                {% else %}
                    <div class="verification-icon text-danger">
                        <i class="fas fa-times-circle"></i>
                    </div>
                    <h3>Invalid Ticket</h3>
                    <p class="lead">This ticket is not valid. It may have been used already or cancelled.</p>
                {% endif %}
                
                <div class="ticket-info">
                    <h5>Ticket Information</h5>
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>ID:</strong> #{{ billet.id }}</p>
                            <p><strong>Type:</strong> {{ billet.typebillet }}</p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Status:</strong> {{ billet.statut }}</p>
                            <p><strong>Event:</strong> {{ billet.eventid ? billet.eventid.name : 'N/A' }}</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %} 