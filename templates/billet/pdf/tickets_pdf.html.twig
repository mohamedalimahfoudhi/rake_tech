<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Tickets Export - RackeTech</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 12px;
            margin: 0;
            padding: 20px;
        }
        .header {
            text-align: center;
            margin-bottom: 30px;
            border-bottom: 1px solid #ddd;
            padding-bottom: 10px;
        }
        .logo {
            font-size: 24px;
            font-weight: bold;
            color: #333;
        }
        h1 {
            font-size: 18px;
            margin: 10px 0;
            color: #555;
        }
        .info-section {
            margin-bottom: 20px;
        }
        .info-item {
            margin-bottom: 5px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin: 20px 0;
        }
        th, td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: left;
        }
        th {
            background-color: #f2f2f2;
        }
        tr:nth-child(even) {
            background-color: #f9f9f9;
        }
        .footer {
            margin-top: 50px;
            text-align: center;
            font-size: 10px;
            color: #777;
            border-top: 1px solid #ddd;
            padding-top: 10px;
        }
        .status-valid {
            color: green;
        }
        .status-used {
            color: gray;
        }
        .status-invalid {
            color: red;
        }
        .summary {
            margin: 20px 0;
            padding: 10px;
            background-color: #f5f5f5;
            border-radius: 5px;
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="logo">RackeTech</div>
        <h1>Tickets Export</h1>
        <p>Generated on: {{ "now"|date("Y-m-d H:i:s") }}</p>
    </div>
    
    <div class="info-section">
        <div class="info-item"><strong>Total Tickets:</strong> {{ billets|length }}</div>
        <div class="info-item"><strong>Currency:</strong> {{ selectedCurrency }}</div>
        {% if filterType %}
        <div class="info-item"><strong>Filtered by Type:</strong> {{ filterType }}</div>
        {% endif %}
    </div>
    
    <div class="summary">
        <h2>Summary</h2>
        <div class="info-item"><strong>Total Value ({{ selectedCurrency }}):</strong> {{ (totalValue * selectedRate)|number_format(2) }}</div>
    </div>
    
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Type</th>
                <th>Event</th>
                <th>Price ({{ selectedCurrency }})</th>
                <th>Quantity</th>
                <th>Total</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            {% for billet in billets %}
            <tr>
                <td>#{{ billet.id }}</td>
                <td>{{ billet.typebillet }}</td>
                <td>{{ billet.eventid ? billet.eventid.name : 'No event' }}</td>
                <td>{{ (billet.prix * selectedRate)|number_format(2) }}</td>
                <td>{{ billet.quantite }}</td>
                <td>{{ (billet.prix * billet.quantite * selectedRate)|number_format(2) }}</td>
                <td class="status-{{ billet.statut|lower }}">{{ billet.statut }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    
    <div class="footer">
        <p>This document was generated by RackeTech. For any questions, please contact support.</p>
        <p>&copy; {{ "now"|date("Y") }} RackeTech. All rights reserved.</p>
    </div>
</body>
</html> 