{% extends 'base.html.twig' %}

{% block title %}Gestion des Tournois{% endblock %}


{% block body %}
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <nav class="col-md-3 col-lg-2 d-md-block bg-light sidebar">
                <div class="position-sticky pt-3">
                    <!-- Logo and User Info -->
                    <div class="text-center mb-4">
                        <div class="logo mb-3">
                            <span class="logo-racket">🎾</span>
                            <span class="logo-text">RackeTech</span>
                        </div>
                        <div class="dropdown">
                            <a class="dropdown-toggle text-dark text-decoration-none" href="#" role="button" id="userDropdown" data-bs-toggle="dropdown">
                                <i class="fas fa-user-circle me-1"></i> {{ app.user.prenom }}
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="{{ path('app_profile') }}">Profile</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="{{ path('app_logout') }}">Logout</a></li>
                            </ul>
                        </div>
                    </div>

                    <!-- Navigation -->
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_dashboard') }}">
                                <i class="fas fa-tachometer-alt"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_user_management') }}">
                                <i class="fas fa-users"></i> User Management
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_emprunt_index') }}">
                                <i class="fas fa-users"></i> Emprunt Management
                            </a>
                        </li>
                             <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_materiel_index') }}">
                                <i class="fas fa-users"></i> Materiels Management
                            </a>
                        </li>
                         </li>
                             <li class="nav-item">
                            <a class="nav-link active " href="{{ path('app_tournoi_index') }}">
                                <i class="fas fa-users"></i> Tournoi Management
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link  " href="{{ path('app_reservation_index') }}">
                                <i class="fas fa-users"></i> Reservation Management
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <i class="fas fa-cog"></i> Settings
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <i class="fas fa-chart-bar"></i> Reports
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <i class="fas fa-bell"></i> Notifications
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>

            <!-- Main content -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2">Tournoi Management</h1>
                    <div class="btn-toolbar mb-2 mb-md-0">
                        <div class="btn-group me-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary">Export</button>
                        </div>
                        <div class="btn-group me-2">
                            <a href="{{ path('app_tournoi_new') }}" class="btn btn-primary">
                            <i class="fas fa-plus"></i> Nouvel Tournoi
                            </a>                        
                        </div>
                    </div>
                </div>

                                <form method="get" action="{{ path('app_tournoi_index') }}" class="mb-3">
                    <div class="form-group">
                        <label for="statutFilter">Filtrer par statut</label>
                        <select name="statut" id="statutFilter" class="form-control">
                            <option value="">Tous</option>
                            <option value="Prévu" {% if statutFilter == 'Prévu' %}selected{% endif %}>Prévu</option>
                            <option value="En cours" {% if statutFilter == 'En cours' %}selected{% endif %}>En cours</option>
                            <option value="Terminé" {% if statutFilter == 'Terminé' %}selected{% endif %}>Terminé</option>
                            <option value="Annulé" {% if statutFilter == 'Annulé' %}selected{% endif %}>Annulé</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary mt-2">Filtrer</button>
                </form>

                {% for message in app.flashes('success') %}
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {% endfor %}

                {% for message in app.flashes('error') %}
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {% endfor %}

            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="thead-light">
                            <tr>
                                <th>Nom</th>
                                <th>Date de début</th>
                                <th>Date de fin</th>
                                <th>Lieu</th>
                                <th>Type de sport</th>
                                <th>Statut</th>
                                <th>Récompense</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for tournoi in tournois %}
                            <tr>
                                <td>{{ tournoi.nom }}</td>
                                <td>{{ tournoi.datedebut ? tournoi.datedebut|date('d/m/Y') : '' }}</td>
                                <td>{{ tournoi.datefin ? tournoi.datefin|date('d/m/Y') : '' }}</td>
                                <td>{{ tournoi.lieu }}</td>
                                <td>{{ tournoi.typesport }}</td>
                                <td>
                                    <span class="badge badge-{{ tournoi.statut == 'En cours' ? 'success' : (tournoi.statut == 'Terminé' ? 'secondary' : 'primary') }}">
                                        {{ tournoi.statut }}
                                    </span>
                                </td>
                                <td>{{ tournoi.recompense }}</td>
                                <td>
                                    <div class="btn-group">
                                        <a href="{{ path('app_tournoi_show', {'id': tournoi.id}) }}" class="btn btn-sm btn-info" title="Voir">
                                            <i class="ri-eye-line"></i>
                                        </a>
                                        <a href="{{ path('app_tournoi_edit', {'id': tournoi.id}) }}" class="btn btn-sm btn-warning" title="Modifier">
                                            <i class="ri-edit-line"></i>
                                        </a>
                                                                {{ include('tournoi/_delete_form.html.twig') }}

                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="8" class="text-center">Aucun tournoi trouvé</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
