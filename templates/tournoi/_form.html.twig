{{ form_start(form) }}
    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        {{ form_label(form.nom, 'Nom du tournoi') }}
                        {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.nom) }}
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        {{ form_label(form.typesport, 'Type de sport') }}
                        {{ form_widget(form.typesport, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.typesport) }}
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        {{ form_label(form.datedebut, 'Date de début') }}
                        {{ form_widget(form.datedebut, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.datedebut) }}
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        {{ form_label(form.datefin, 'Date de fin') }}
                        {{ form_widget(form.datefin, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.datefin) }}
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        {{ form_label(form.lieu, 'Lieu') }}
                        {{ form_widget(form.lieu, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.lieu) }}
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        {{ form_label(form.eventid, 'ID de l\'événement') }}
                        {{ form_widget(form.eventid, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.eventid) }}
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        {{ form_label(form.recompense, 'Récompense') }}
                        {{ form_widget(form.recompense, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.recompense) }}
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        {{ form_label(form.statut, 'Statut') }}
                        {{ form_widget(form.statut, {
                            'attr': {'class': 'form-control'}
                        }) }}
                        {{ form_errors(form.statut) }}
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">
                <i class="ri-save-line"></i> {{ button_label|default('Enregistrer') }}
            </button>
            <a href="{{ path('app_tournoi_index') }}" class="btn btn-secondary">
                <i class="ri-arrow-go-back-line"></i> Retour à la liste
            </a>
        </div>
    </div>
{{ form_end(form) }}
