{% extends 'base.html.twig' %}

{% block title %}Forgot Password{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h3 class="text-center">Forgot Password</h3>
                </div>
                <div class="card-body">
                    {% for message in app.flashes('error') %}
                        <div class="alert alert-danger">
                            {{ message }}
                        </div>
                    {% endfor %}

                    {% for message in app.flashes('success') %}
                        <div class="alert alert-success">
                            {{ message }}
                        </div>
                    {% endfor %}

                    {% if not verification_sent %}
                        <form method="post" action="{{ path('app_forgot_password') }}" id="forgotPasswordForm">
                            <div class="mb-3">
                                <label for="email" class="form-label">Email</label>
                                <input type="email" class="form-control" id="email" name="email" required 
                                       placeholder="Enter your registered email">
                                <div id="email-feedback" class="invalid-feedback">
                                    Please enter a valid email address.
                                </div>
                            </div>
                            <div class="mb-3">
                                <label for="phone" class="form-label">Phone Number</label>
                                <input type="tel" class="form-control" id="phone" name="phone" required 
                                       placeholder="Enter your registered phone number">
                                <div id="phone-feedback" class="invalid-feedback">
                                    Please enter a valid 8-digit phone number.
                                </div>
                            </div>
                            <div class="d-grid">
                                <button type="submit" class="btn btn-primary" id="sendCodeButton">Send Verification Code</button>
                            </div>
                        </form>
                        
                        <script>
                            document.addEventListener('DOMContentLoaded', function() {
                                const emailInput = document.getElementById('email');
                                const phoneInput = document.getElementById('phone');
                                const sendCodeButton = document.getElementById('sendCodeButton');
                                const emailFeedback = document.getElementById('email-feedback');
                                const phoneFeedback = document.getElementById('phone-feedback');
                                
                                function validateEmail(email) {
                                    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                                    return emailRegex.test(email);
                                }
                                
                                function validatePhone(phone) {
                                    // Tunisian phone number: 8 digits
                                    const phoneRegex = /^[0-9]{8}$/;
                                    return phoneRegex.test(phone);
                                }
                                
                                function validateForm() {
                                    const email = emailInput.value.trim();
                                    const phone = phoneInput.value.trim();
                                    let isValid = true;
                                    
                                    // Validate email
                                    if (!validateEmail(email)) {
                                        emailInput.classList.add('is-invalid');
                                        emailFeedback.style.display = 'block';
                                        isValid = false;
                                    } else {
                                        emailInput.classList.remove('is-invalid');
                                        emailFeedback.style.display = 'none';
                                    }
                                    
                                    // Validate phone
                                    if (!validatePhone(phone)) {
                                        phoneInput.classList.add('is-invalid');
                                        phoneFeedback.style.display = 'block';
                                        isValid = false;
                                    } else {
                                        phoneInput.classList.remove('is-invalid');
                                        phoneFeedback.style.display = 'none';
                                    }
                                    
                                    sendCodeButton.disabled = !isValid;
                                    return isValid;
                                }
                                
                                emailInput.addEventListener('input', validateForm);
                                phoneInput.addEventListener('input', validateForm);
                                
                                document.getElementById('forgotPasswordForm').addEventListener('submit', function(event) {
                                    if (!validateForm()) {
                                        event.preventDefault();
                                    }
                                });
                                
                                // Initial validation
                                validateForm();
                            });
                        </script>
                    {% else %}
                        <form method="post" action="{{ path('app_verify_reset_code') }}" id="passwordResetForm">
                            <div class="mb-3">
                                <label for="verification_code" class="form-label">Verification Code</label>
                                <input type="text" class="form-control" id="verification_code" name="verification_code" 
                                       required placeholder="Enter the code sent to your phone">
                            </div>
                            <div class="mb-3">
                                <label for="new_password" class="form-label">New Password</label>
                                <input type="password" class="form-control" id="new_password" name="new_password" 
                                       required placeholder="Enter new password">
                                <div class="password-requirements text-muted small mt-1">
                                    <ul class="ps-3 mb-0">
                                        <li id="length-check">Must be at least 8 characters</li>
                                        <li id="alphanumeric-check">Must contain only letters and numbers</li>
                                    </ul>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label for="confirm_password" class="form-label">Confirm Password</label>
                                <input type="password" class="form-control" id="confirm_password" name="confirm_password" 
                                       required placeholder="Confirm new password">
                                <div id="password-match-feedback" class="invalid-feedback">
                                    Passwords do not match
                                </div>
                            </div>
                            <div class="d-grid">
                                <button type="submit" class="btn btn-primary" id="submitButton">Reset Password</button>
                            </div>
                        </form>
                    {% endif %}
                    
                    <div class="text-center mt-3">
                        <a href="{{ path('app_login') }}" class="text-decoration-none">Back to Login</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{% if verification_sent %}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const newPasswordInput = document.getElementById('new_password');
        const confirmPasswordInput = document.getElementById('confirm_password');
        const submitButton = document.getElementById('submitButton');
        const lengthCheck = document.getElementById('length-check');
        const alphanumericCheck = document.getElementById('alphanumeric-check');
        const passwordMatchFeedback = document.getElementById('password-match-feedback');
        
        function validatePassword() {
            const password = newPasswordInput.value;
            const confirmPassword = confirmPasswordInput.value;
            let isValid = true;
            
            // Check length
            if (password.length >= 8) {
                lengthCheck.classList.add('text-success');
                lengthCheck.classList.remove('text-danger');
            } else {
                lengthCheck.classList.add('text-danger');
                lengthCheck.classList.remove('text-success');
                isValid = false;
            }
            
            // Check alphanumeric only
            if (/^[a-zA-Z0-9]+$/.test(password)) {
                alphanumericCheck.classList.add('text-success');
                alphanumericCheck.classList.remove('text-danger');
            } else {
                alphanumericCheck.classList.add('text-danger');
                alphanumericCheck.classList.remove('text-success');
                isValid = false;
            }
            
            // Check if passwords match
            if (password && confirmPassword) {
                if (password === confirmPassword) {
                    confirmPasswordInput.classList.remove('is-invalid');
                    passwordMatchFeedback.style.display = 'none';
                } else {
                    confirmPasswordInput.classList.add('is-invalid');
                    passwordMatchFeedback.style.display = 'block';
                    isValid = false;
                }
            }
            
            submitButton.disabled = !isValid;
            return isValid;
        }
        
        newPasswordInput.addEventListener('input', validatePassword);
        confirmPasswordInput.addEventListener('input', validatePassword);
        
        document.getElementById('passwordResetForm').addEventListener('submit', function(event) {
            if (!validatePassword()) {
                event.preventDefault();
            }
        });
        
        // Initial validation
        validatePassword();
    });
</script>
{% endif %}
{% endblock %} 