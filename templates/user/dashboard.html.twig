{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="row">
        <div class="col-md-3">
            <div class="sidebar p-3">
                <div class="text-center mb-4">
                    <img src="{{ asset('images/default-avatar.png') }}" alt="Profile Picture" class="profile-picture mb-3">
                    <h5>{{ app.user.firstName }} {{ app.user.lastName }}</h5>
                    <p class="text-muted">{{ app.user.email }}</p>
                </div>
                <nav class="nav flex-column">
                    <a class="nav-link active" href="{{ path('user_dashboard') }}">
                        <i class="fas fa-home me-2"></i> Dashboard
                    </a>
                    <a class="nav-link" href="{{ path('user_profile') }}">
                        <i class="fas fa-user me-2"></i> Profile
                    </a>
                    <a class="nav-link" href="{{ path('user_settings') }}">
                        <i class="fas fa-cog me-2"></i> Settings
                    </a>
                    <a class="nav-link" href="{{ path('app_logout') }}">
                        <i class="fas fa-sign-out-alt me-2"></i> Logout
                    </a>
                </nav>
            </div>
        </div>
        <div class="col-md-9">
            <h2 class="mb-4">Dashboard Overview</h2>
            
            <div class="row mb-4">
                <div class="col-md-4">
                    <div class="card stats-card bg-primary text-white">
                        <div class="card-body">
                            <h5 class="card-title">Total Projects</h5>
                            <p class="card-text">12</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card stats-card bg-success text-white">
                        <div class="card-body">
                            <h5 class="card-title">Active Tasks</h5>
                            <p class="card-text">8</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card stats-card bg-info text-white">
                        <div class="card-body">
                            <h5 class="card-title">Completed Tasks</h5>
                            <p class="card-text">24</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Recent Activities</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Activity</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Project Alpha Update</td>
                                    <td>2024-03-15</td>
                                    <td><span class="badge bg-success">Completed</span></td>
                                </tr>
                                <tr>
                                    <td>New Task Assignment</td>
                                    <td>2024-03-14</td>
                                    <td><span class="badge bg-warning">In Progress</span></td>
                                </tr>
                                <tr>
                                    <td>Team Meeting</td>
                                    <td>2024-03-13</td>
                                    <td><span class="badge bg-info">Scheduled</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <a href="#" class="btn btn-primary w-100 mb-2">
                                <i class="fas fa-plus me-2"></i> New Project
                            </a>
                        </div>
                        <div class="col-md-4">
                            <a href="#" class="btn btn-success w-100 mb-2">
                                <i class="fas fa-tasks me-2"></i> Create Task
                            </a>
                        </div>
                        <div class="col-md-4">
                            <a href="#" class="btn btn-info w-100 mb-2">
                                <i class="fas fa-calendar me-2"></i> Schedule Meeting
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %} 