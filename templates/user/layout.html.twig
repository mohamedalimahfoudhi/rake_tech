{% extends 'base.html.twig' %}

{% block title %}User Dashboard{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200">
    <link rel="stylesheet" href="{{ asset('css/sliding-menu.css') }}">
    <style>
        .menu {
            background: rgba(46, 204, 113, 0.95); /* Green-themed for user dashboard (matches tennis theme) */
            box-shadow: 5px 0 15px rgba(46, 204, 113, 0.2);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .menu:hover {
            box-shadow: 5px 0 20px rgba(46, 204, 113, 0.3);
        }
        .menu-content a.active .material-symbols-outlined {
            background: #f1c40f; /* Tennis ball yellow for active items */
            transform: scale(1.1);
            box-shadow: 0 0 15px rgba(241, 196, 15, 0.3);
        }
        
        /* Logo styling for user menu */
        .user-menu-logo {
            display: flex;
            align-items: center;
            padding: 0 20px 30px 20px;
            margin-bottom: 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.2);
            overflow: hidden;
        }
        
        .user-menu-logo a {
            display: flex;
            align-items: center;
            text-decoration: none;
            color: white;
            transition: transform 0.3s ease;
        }
        
        .user-menu-logo a:hover {
            transform: scale(1.1);
        }
        
        .user-menu-logo a:hover .logo-racket {
            animation: spin 1s ease;
        }
        
        @keyframes spin {
            0% {
                transform: rotate(0deg);
            }
            100% {
                transform: rotate(360deg);
            }
        }
        
        .logo-racket {
            font-size: 1.8rem;
            margin-right: 10px;
            animation: bounce 2s infinite;
        }
        
        @keyframes bounce {
            0%, 20%, 50%, 80%, 100% {
                transform: translateY(0);
            }
            40% {
                transform: translateY(-10px);
            }
            60% {
                transform: translateY(-5px);
            }
        }
        
        /* Mobile responsive adjustments */
        @media (max-width: 767.98px) {
            .menu:not(.menu-active) .user-menu-logo {
                display: none;
            }
            
            .menu.menu-active .user-menu-logo {
                display: flex;
            }
            
            .menu.menu-active .logo-text {
                display: block;
            }
        }
        
        .logo-text {
            background: linear-gradient(45deg, #ffffff, #f1f1f1);
            background-size: 200% 200%;
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            font-weight: 700;
            font-size: 1.5rem;
            animation: gradient 3s ease infinite;
            white-space: nowrap;
        }
        
        /* Tennis theme hover effects for menu items */
        .menu-content a:hover .material-symbols-outlined {
            background: rgba(241, 196, 15, 0.5); /* Tennis ball yellow */
            box-shadow: 0 0 10px rgba(241, 196, 15, 0.3);
        }
        
        @keyframes gradient {
            0% {
                background-position: 0% 50%;
            }
            50% {
                background-position: 100% 50%;
            }
            100% {
                background-position: 0% 50%;
            }
        }
        
        .menu:not(:hover) .logo-text {
            display: none;
        }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/sliding-menu.js') }}"></script>
{% endblock %}

{% block body %}
    <div class="menu">
        <div class="user-menu-logo">
            <a href="{{ path('user_dashboard') }}">
                <span class="logo-racket">🎾</span>
                <span class="logo-text">RackeTech</span>
            </a>
        </div>
        <ul class="menu-content">
            <li><a href="{{ path('user_dashboard') }}" class="{% if app.request.get('_route') == 'user_dashboard' %}active{% endif %}">
                <span class="material-symbols-outlined">dashboard</span><span>Dashboard</span>
            </a></li>
            <li><a href="{{ path('user_profile') }}" class="{% if app.request.get('_route') == 'user_profile' %}active{% endif %}">
                <span class="material-symbols-outlined">person</span><span>Profile</span>
            </a></li>
            <li><a href="{{ path('app_logout') }}">
                <span class="material-symbols-outlined">logout</span><span>Logout</span>
            </a></li>
        </ul>
    </div>

    <main class="content py-4 px-4">
        {% if app.request.get('_route') == 'user_dashboard' %}
            <div class="tennis-welcome mb-4">
                <h1>Welcome to <span class="tennis-text">RackeTech</span> <span class="tennis-emoji">🎾</span></h1>
                <p>Your ultimate tennis event management platform</p>
            </div>
        {% endif %}
        {% block user_content %}{% endblock %}
    </main>

    <style>
        .tennis-welcome {
            text-align: center;
            padding: 20px;
            background: rgba(46, 204, 113, 0.1);
            border-radius: 10px;
            border-left: 5px solid #2ecc71;
            backdrop-filter: blur(5px);
        }
        
        .tennis-text {
            background: linear-gradient(45deg, #2ecc71, #f1c40f);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            font-weight: 700;
        }
        
        .tennis-emoji {
            display: inline-block;
            animation: spin-slow 6s linear infinite;
        }
        
        @keyframes spin-slow {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
    </style>
{% endblock %} 